module;
#include "details/terminal-colors.h++"

export module tester:console_observer;
import :data;
import :observer;
import :utils;
import std;

namespace tester::output::console
{

namespace color = ::term;
using namespace data;

// The buffer this keeps is what a failing test reports, so it is also the run's output capture.
// Capture text is thread_local so parallel top-level workers do not interleave assertion lines
// into one shared ostringstream; human/result streams still take the mutex below.
export struct observer final : tester::output::observer, tester::output::output_capture
{
    std::ostream& human;
    std::ostream& result;
    bool result_line;
    bool verbose = false;
    // Set by activate(); once the process sink is live, observer_instance must not emplace.
    bool activated = false;

    // Protects human/result stream writes (catalogue, summary, failures). Capture uses TLS.
    mutable std::mutex mutex{};

    explicit observer(std::ostream& human_stream, std::ostream& result_stream, bool emit_result_line)
        : human{human_stream}, result{result_stream}, result_line{emit_result_line}
    {}

    std::ostream& human_os() { return human; }
    std::ostream& result_os() { return result; }

    static std::ostringstream& tls_stream()
    {
        thread_local std::ostringstream stream{};
        return stream;
    }

    // For callers that already hold the lock. reset() is the locked entry point, which the
    // engine uses to hand the buffer back empty between tests.
    void clear_buffer()
    {
        tls_stream() = std::ostringstream{};
    }

    void activate() override
    {
        activated = true;
        capture_into(*this);
    }

    std::string text() const override
    {
        return std::string{tls_stream().view()};
    }

    void reset() override
    {
        clear_buffer();
    }

    void on_test_case(const data::test_case& tc)
    {
        clear_buffer();
        auto& stream = tls_stream();

        if(tc.test_name.starts_with("scenario") or tc.test_name.starts_with("test_case"))
            stream << color::background::blue
                << tc.test_set_name
                << color::reset << '\n';

        stream << color::text::blue
               << tc.test_name << " "
               << "(" << tc.file_name << " " <<  tc.line << ":" <<  tc.column << ")"
               << color::reset << '\n';
    }

    void test_case(const data::test_case& tc) override
    {
        on_test_case(tc);
    }

    void on_exception(const data::test_case& tc, const std::exception& ex)
    {
        tls_stream() << color::background::red
               << ex.what()
               << " " << tc.test_name << " "
               << "(" << tc.file_name << " " <<  tc.line << ":" <<  tc.column << ")"
               << color::reset << '\n';
    }

    void exception(const data::test_case& tc, const std::exception& ex) override
    {
        on_exception(tc, ex);
    }

    void assertion(const assertion_event& event) override
    {
        auto& stream = tls_stream();
        stream << (event.ok ? color::text::green : color::text::red)
               << event.display_matcher << '\n'
               << "  actual:   " << event.actual.display << '\n'
               << "  expected: " << event.expected.display << '\n'
               << "  location: " << event.file << " "
               << event.line << ":" << event.column
               << color::reset << '\n';

        if(verbose)
        {
            auto lock = std::lock_guard<std::mutex>{mutex};
            std::clog << stream.view();
        }
    }

    void message(const message_event& event) override
    {
        auto& stream = tls_stream();
        stream << (event.ok ? color::text::yellow : color::text::red)
               << event.display_matcher << '\n'
               << "  message:  " << event.message << '\n'
               << "  location: " << event.file << " "
               << event.line << ":" << event.column
               << color::reset << '\n';

        if(verbose)
        {
            auto lock = std::lock_guard<std::mutex>{mutex};
            std::clog << stream.view();
        }
    }

    void print_test_cases(std::span<const data::test_case* const> matched)
    {
        human_os() << "Test cases:\n";
        for(const auto* tc : matched)
            human_os() << color::text::yellow
                       << tc->test_name
                       << " (" << tc->file_name << " " << tc->line << ':' << tc->column << ")"
                       << color::reset << std::endl;
    }

    void test_catalogue(const catalogue& tests) override
    {
        auto lock = std::lock_guard<std::mutex>{mutex};
        print_test_cases(tests.matched);
    }

    void print_test_results()
    {
        human_os() << color::text::yellow
                   << "Test results:"
                   << color::reset << '\n';
        for(auto result : data::results())
            human_os() << result.output;
    }

    void test_results() override
    {
        auto lock = std::lock_guard<std::mutex>{mutex};
        print_test_results();
    }

    void print_test_failures()
    {
        auto any_failures = false;
        for(const auto& result : data::results())
            if(not result.success) { any_failures = true; break; }

        if(!any_failures)
        {
            human_os() << color::text::green
                       << "No test failures."
                       << color::reset << '\n';
            return;
        }

        human_os() << color::text::red
                   << "Test failures:"
                   << color::reset << '\n';

        for(const auto& result : data::results())
            if(not result.success)
                human_os() << result.output;
    }

    void test_failures() override
    {
        auto lock = std::lock_guard<std::mutex>{mutex};
        print_test_failures();
    }

    void print_test_statistics(const run_summary& run, bool want_result_line)
    {
        const auto& stats = run.statistics;
        const auto run_started = stats.run_started;
        const auto run_finished = stats.run_finished;
        const auto run_tags = std::string_view{stats.run_tags};
        const auto tests_ok = stats.successful_tests.load(std::memory_order_relaxed);
        const auto tests_total = stats.total_tests.load(std::memory_order_relaxed);
        const auto assertions_ok = stats.successful_assertions.load(std::memory_order_relaxed);
        const auto assertions_total = stats.total_assertions.load(std::memory_order_relaxed);
        const auto failed_tests = tests_total - tests_ok;
        const auto failed_assertions = assertions_total - assertions_ok;

        auto pct = [](std::size_t ok, std::size_t total){
            if(total == 0) return 100.0;
            return 100.0 * static_cast<double>(ok) / static_cast<double>(total);
        };

        human_os() << color::text::yellow
                   << "Test statistics:" << '\n'
                   << "tests:      " << tests_ok << "/" << tests_total
                   << " passed"
                   << " (" << std::fixed << std::setprecision(1) << pct(tests_ok, tests_total) << "%)"
                   << " | failed: " << failed_tests << '\n'
                   << "assertions: " << assertions_ok << "/" << assertions_total
                   << " passed"
                   << " (" << std::fixed << std::setprecision(1) << pct(assertions_ok, assertions_total) << "%)"
                   << " | failed: " << failed_assertions
                   << color::reset << std::endl;

        if(run_finished != std::chrono::steady_clock::time_point{})
        {
            const auto dur = std::chrono::duration_cast<std::chrono::milliseconds>(
                run_finished - run_started);
            human_os() << color::text::yellow
                       << "duration:  " << dur.count() << "ms"
                       << color::reset << '\n';
        }

        if(!run_tags.empty())
        {
            human_os() << color::text::yellow
                       << "filter:    " << run_tags
                       << color::reset << '\n';
        }

        if(not run.slowest.empty())
        {
            human_os() << color::text::yellow << "Slowest tests:" << color::reset << '\n';
            for(const auto* r : run.slowest)
            {
                human_os()
                    << "  " << std::chrono::duration_cast<std::chrono::milliseconds>(r->duration).count() << "ms  "
                    << r->test_name
                    << " (" << r->file_name << " " << r->line << ":" << r->column << ")"
                    << '\n';
            }
        }

        if(want_result_line)
        {
            result_os()
                << "RESULT:"
                << " tests_ok=" << tests_ok
                << " tests_total=" << tests_total
                << " assertions_ok=" << assertions_ok
                << " assertions_total=" << assertions_total
                << " passed=" << (run.passed ? "true" : "false")
                << '\n';
        }
    }

    void summary(const run_summary& run, const failure_index&) override
    {
        auto lock = std::lock_guard<std::mutex>{mutex};
        print_test_statistics(run, result_line);
    }
};

export inline auto& observer_instance(std::ostream& human, std::ostream& result, bool result_line = false)
{
    // Before activate(), a second call may replace streams/flags (startup sink selection).
    // After activate(), emplace would destroy a mutex that notify may hold and drop the
    // capture registration — so only the result_line flag may change on a live sink.
    static auto value = std::optional<observer>{};
    if(value.has_value() and value->activated)
    {
        value->result_line = result_line;
        return *value;
    }
    value.emplace(human, result, result_line);
    return *value;
}

} // namespace tester::output::console
