export module tester:observer;
import :data;
import std;

namespace tester::output
{

export struct failure_index
{
    std::vector<std::string> failed_test_ids;
    const data::test_result* first = nullptr;
};

export enum class value_kind
{
    text,
    number,
    boolean,
    null
};

export struct observed_value
{
    std::string display;
    std::string value;
    value_kind kind = value_kind::text;
};

export struct assertion_event
{
    bool ok;
    std::string matcher;
    std::string display_matcher;
    observed_value actual;
    observed_value expected;
    std::string message;
    std::string test_id;
    std::string file;
    std::uint_least32_t line;
    std::uint_least32_t column;
};

export struct message_event
{
    bool ok;
    std::string message;
    std::string display_matcher;
    std::string file;
    std::uint_least32_t line;
    std::uint_least32_t column;
    std::string caller_file;
    std::uint_least32_t caller_line;
};

// What a run is, for as long as it lasts: the fields run_start reports and nothing changes
// afterwards. Passed as one value because seven positional arguments — four of them
// string_view — are four chances to transpose two of them at the call site.
export struct run_info
{
    std::string_view mode;   // "run" or "list"
    std::string_view tags;   // the filter as the caller wrote it
    std::string_view cwd;
    std::string_view config; // build configuration, empty unless CB set TESTER_CONFIG
    std::chrono::system_clock::time_point started_at{};
    std::span<const std::string> argv;
    std::span<const std::pair<std::string, std::string>> env;
};

// How a run ended. The failure index stays a separate argument because the summary reports the
// same one — one description of what failed, two events carrying it.
export struct run_verdict
{
    std::string_view mode;
    std::string_view tags;
    bool passed = false;
    std::chrono::system_clock::time_point started_at{};
    std::chrono::system_clock::time_point ended_at{};
};

// The aggregates a run finishes with. The ranking is the runner's, already cut to the length
// that was asked for, so every sink reports the same tests in the same order.
export struct run_summary
{
    const data::test_statistics& statistics;
    bool passed = false;
    std::span<const data::test_result* const> slowest; // empty unless a ranking was requested
};

// What a list run found: the matched tests in registration order, and the total the filter chose
// from. Selection is the runner's job, so a sink renders this rather than re-deciding it.
export struct catalogue
{
    std::span<const data::test_case* const> matched;
    std::size_t registered_total = 0;
    std::string_view tags_filter;
};

export class observer
{
public:
    virtual ~observer() = default;

    virtual void activate() {}
    virtual void eof() {}

    virtual void run_start(const run_info&) {}
    virtual void run_end(const run_verdict&, const failure_index&) {}

    virtual void test_catalogue(const catalogue&) {}

    virtual void test_case(const data::test_case&) {}
    virtual void exception(const data::test_case&, const std::exception&) {}
    virtual void assertion(const assertion_event&) {}
    virtual void message(const message_event&) {}

    virtual void test_results() {}

    virtual void test_failures() {}

    virtual void summary(const run_summary&, const failure_index&) {}
};

// The text a test collected while it ran, which is the console observer's buffer — it is the one
// that writes per-assertion detail, and a failing test reports it. Not an observer method: this
// is a question asked of one buffer and an instruction to empty it, so broadcasting it to every
// sink would need a rule for which answer wins.
export class output_capture
{
public:
    virtual ~output_capture() = default;

    // By value: the buffer goes on changing, and the assertions filling it may come from a
    // thread the test started.
    virtual std::string text() const = 0;
    virtual void reset() = 0;
};

inline output_capture* g_capture = nullptr;
inline auto g_observers = std::vector<std::reference_wrapper<observer>>{};
inline auto g_named_observers = std::vector<std::pair<std::string, std::reference_wrapper<observer>>>{};
// Parallel workers notify while a test may observe()/unobserve() mid-run; the registry
// itself needs a lock (individual observers already take their own).
inline std::mutex g_observers_mutex{};

export void register_observer(std::string_view name, observer& value)
{
    auto lock = std::lock_guard<std::mutex>{g_observers_mutex};
    if(const auto found = std::ranges::find_if(g_named_observers, [name](const auto& entry)
    {
        return entry.first == name;
    });
       found != g_named_observers.end())
    {
        found->second = value;
        return;
    }
    g_named_observers.emplace_back(name, value);
}

export void observe(observer& value)
{
    {
        auto lock = std::lock_guard<std::mutex>{g_observers_mutex};
        g_observers.emplace_back(value);
    }
    // Activate outside the registry lock: console activate registers the capture buffer
    // and must not nest with notify's snapshot path.
    value.activate();
}

export void clear_observers()
{
    auto lock = std::lock_guard<std::mutex>{g_observers_mutex};
    g_observers.clear();
    g_capture = nullptr;
}

// Whoever buffers text says so when it is activated. At most one does, and dropping the
// observers drops it with them.
export void capture_into(output_capture& value)
{
    auto lock = std::lock_guard<std::mutex>{g_observers_mutex};
    g_capture = &value;
}

export std::string captured_text()
{
    auto lock = std::lock_guard<std::mutex>{g_observers_mutex};
    return g_capture != nullptr ? g_capture->text() : std::string{};
}

export void reset_captured_text()
{
    auto lock = std::lock_guard<std::mutex>{g_observers_mutex};
    if(g_capture != nullptr)
        g_capture->reset();
}

export bool select_observer(std::string_view name)
{
    observer* selected = nullptr;
    {
        auto lock = std::lock_guard<std::mutex>{g_observers_mutex};
        const auto found = std::ranges::find_if(g_named_observers, [name](const auto& entry)
        {
            return entry.first == name;
        });
        if(found == g_named_observers.end())
            return false;

        g_observers.clear();
        g_capture = nullptr;
        selected = &found->second.get();
        g_observers.emplace_back(*selected);
    }
    selected->activate();
    return true;
}

export void unobserve(observer& value)
{
    auto lock = std::lock_guard<std::mutex>{g_observers_mutex};
    std::erase_if(g_observers, [&value](const auto target)
    {
        return std::addressof(target.get()) == std::addressof(value);
    });
}

export template<typename Callback>
void notify(Callback&& callback)
{
    // Snapshot under the lock so observe/unobserve cannot invalidate the walk; invoke
    // outside so an observer's own mutex cannot deadlock against registry mutations.
    auto targets = std::vector<std::reference_wrapper<observer>>{};
    {
        auto lock = std::lock_guard<std::mutex>{g_observers_mutex};
        targets = g_observers;
    }
    for(auto target : targets)
        callback(target.get());
}

} // namespace tester::output
