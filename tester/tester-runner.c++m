export module tester:runner;
import :observer;
import :engine;
import :data;
import :utils;
import std;

namespace tester
{
using data::test_case;
using data::test_result;
using output::notify;
using output::observer;

// Public configuration API. Both settings are read by events this class emits — the run argv
// by run_start, the slowest count by the statistics — while the values themselves are stored
// with the run's other data.
export void set_slowest(std::size_t n) { data::set_slowest(n); }
export void set_jobs(std::size_t n) { data::set_jobs(n); }
export void set_run_argv(int argc, char** argv) { data::set_run_argv(argc, argv); }

export class runner
{
public:

    runner(std::string_view tags = "")
        : m_tags{tags}, m_run_mode{}
    {
        if(not m_tags.empty())
        {
            if(auto tag_list = parse_tag_query(m_tags); not tag_list.empty())
            {
                m_literal_tags = std::move(tag_list);
                m_use_literal_tags = true;
            }
            else
            {
                try
                {
                    m_regex = std::regex{m_tags.begin(), m_tags.end()};
                    m_use_regex = true;
                }
                catch(const std::regex_error&)
                {
                    // Invalid regex, fall back to substring matching
                    m_use_regex = false;
                }
            }
        }
    }

    void begin_run(std::string_view mode)
    {
        m_run_has_started = true;
        m_run_started_unix_ms = std::chrono::system_clock::now();
        m_run_started_monotonic = std::chrono::steady_clock::now();
        m_run_finished_monotonic = std::chrono::steady_clock::time_point{};
        m_run_mode = std::string{mode};
        m_pending_run_end_passed = std::nullopt;
        m_run_end_emitted = false;

        const auto cwd = std::filesystem::current_path().string();
        const auto config = environment_value("TESTER_CONFIG");
        const auto run_env = collect_run_env();
        const auto run = output::run_info{
            .mode = m_run_mode,
            .tags = m_tags,
            .cwd = cwd,
            .config = config,
            .started_at = m_run_started_unix_ms,
            .argv = data::run_argv(),
            .env = run_env};
        notify([&](observer& target){ target.run_start(run); });
    }

    void end_run(bool passed)
    {
        if(m_run_has_started)
            m_run_finished_monotonic = std::chrono::steady_clock::now();

        // In "run" mode, defer run_end until after the summary so event order is predictable.
        // report_summary emits it once the aggregates are out.
        if(m_run_mode == "run")
        {
            m_pending_run_end_passed = passed;
            return;
        }

        report_run_end(passed, output::failure_index{});
    }

    // The whole of list mode: the catalogue is the stream, so this closes it.
    void list_tests()
    {
        auto matched = std::vector<const test_case*>{};
        for(const auto& tc : data::test_cases)
            if(included(tc))
                matched.push_back(&tc);

        const auto tests = output::catalogue{
            .matched = matched,
            .registered_total = data::test_cases.size(),
            .tags_filter = m_tags};
        notify([&](observer& target){ target.test_catalogue(tests); });
        close_output();
    }

    void run_tests()
    {
        // Own the execution context for the whole run + reporting cycle so observers
        // still see results/statistics after run_test_cases returns.
        m_execution.emplace();
        m_execution->excluded = [this](const test_case& tc){ return this->excluded(tc); };
        m_execution_scope = std::make_unique<data::execution_scope>(*m_execution);

        begin_run("run");

        engine::init_statistics(
            *m_execution, m_run_started_monotonic, m_run_started_unix_ms, m_tags);

        engine::run_test_cases(*m_execution);

        engine::finish_statistics(*m_execution, m_run_finished_monotonic);
        end_run(all_tests_passed());
    }

    void report_results()
    {
        notify([](observer& target){ target.test_results(); });
    }

    void report_failures()
    {
        notify([](observer& target){ target.test_failures(); });
    }

    // Last of the run, so this closes the stream the way list_tests does.
    void report_summary()
    {
        const auto& stats = data::statistics();
        const auto passed = data::run_passed(stats);
        const auto slowest = slowest_results(data::config().slowest);
        const auto failures = collect_failures();

        const auto run = output::run_summary{
            .statistics = stats,
            .passed = passed,
            .slowest = slowest};
        notify([&](observer& target){ target.summary(run, failures); });

        // The verdict deferred by end_run, emitted now that the aggregates are out. A run that
        // reached the summary without one — report_summary called on its own — reports what the
        // statistics say.
        if(not m_pending_run_end_passed.has_value())
            m_pending_run_end_passed = passed;
        if(not m_run_end_emitted)
            report_run_end(*m_pending_run_end_passed, failures);

        m_last_run_passed = passed;
        close_output();
        m_execution_scope.reset();
        m_execution.reset();
    }

    bool all_tests_passed() const
    {
        // After report_summary the execution context is gone; remember the verdict.
        if(m_execution.has_value())
            return data::run_passed(m_execution->statistics);
        return m_last_run_passed;
    }

    bool included(const test_case& tc) const
    {
        return included(tc.test_name, tc.tags);
    }

    // For callers holding only a name — no registered case to read tags from, so they are
    // parsed here instead. Registration parses the same brackets once and stores the result.
    bool included(std::string_view test_name) const
    {
        return included(test_name, output::extract_bracket_tags(test_name));
    }

private:

    // Owned copy — callers may pass a temporary or argv that does not outlive the runner.
    std::string m_tags;
    std::regex m_regex;
    bool m_use_regex = false;
    bool m_use_literal_tags = false;
    std::vector<std::string> m_literal_tags;

    // Run state
    std::chrono::system_clock::time_point m_run_started_unix_ms{};
    std::chrono::steady_clock::time_point m_run_started_monotonic{};
    std::chrono::steady_clock::time_point m_run_finished_monotonic{};
    bool m_run_has_started = false;
    std::string m_run_mode;
    std::optional<data::execution_context> m_execution;
    std::unique_ptr<data::execution_scope> m_execution_scope;
    bool m_last_run_passed = false;
    std::optional<bool> m_pending_run_end_passed;
    bool m_run_end_emitted = false;

    // Whichever mode ran, its last event is the end of the stream.
    void close_output()
    {
        notify([](observer& target){ target.eof(); });
    }

    // One place emits run_end, whichever path decided the verdict, so the latch has one owner.
    void report_run_end(bool passed, const output::failure_index& failures)
    {
        const auto run = output::run_verdict{
            .mode = m_run_mode,
            .tags = m_tags,
            .passed = passed,
            .started_at = m_run_started_unix_ms,
            .ended_at = std::chrono::system_clock::now()};
        notify([&](observer& target){ target.run_end(run, failures); });
        m_run_end_emitted = true;
    }

    static std::string environment_value(const char* key)
    {
        const auto* value = std::getenv(key);
        return value != nullptr ? std::string{value} : std::string{};
    }

    // Sandbox switches worth recording with the run: a suite that skipped network tests reports
    // different totals, and the run_start event is where that is explained.
    static std::vector<std::pair<std::string, std::string>> collect_run_env()
    {
        constexpr auto keys = std::array{"NET_DISABLE_NETWORK_TESTS", "CURSOR_SANDBOX"};

        auto out = std::vector<std::pair<std::string, std::string>>{};
        for(const auto* key : keys)
        {
            if(auto value = environment_value(key); not value.empty())
                out.emplace_back(key, std::move(value));
        }
        return out;
    }

    // A test counts as failed if it threw or if any of its assertions failed, which is the same
    // rule the engine uses for tests_ok — so summary.passed cannot disagree with failed_test_ids.
    static output::failure_index collect_failures()
    {
        auto index = output::failure_index{};
        for(const auto& result : data::results())
        {
            if(result.success and result.assertions_ok == result.assertions_total)
                continue;
            index.failed_test_ids.push_back(result.test_id);
            if(index.first == nullptr)
                index.first = &result;
        }
        return index;
    }

    static std::vector<const test_result*> slowest_results(std::size_t count)
    {
        if(count == 0)
            return {};

        auto slowest = std::vector<const test_result*>{};
        slowest.reserve(data::results().size());
        for(const auto& result : data::results())
            slowest.push_back(&result);

        // Stable, so tests that took the same time are ranked in the order they ran. Every sink
        // reports this one ranking, and equal durations are the common case at millisecond
        // resolution — an unstable sort would make the tail of the list arbitrary.
        std::ranges::stable_sort(slowest, [](const test_result* a, const test_result* b)
        {
            return a->duration > b->duration;
        });
        if(slowest.size() > count)
            slowest.resize(count);
        return slowest;
    }

    bool included(std::string_view test_name, std::span<const std::string> tags) const
    {
        if(m_tags.empty() && has_hidden_tag(tags))
            return false;

        if(not is_runnable_test_name(test_name))
            return true;

        if(m_tags.empty())
            return true;

        if(m_use_literal_tags)
            return match_literal_tags(tags);

        if(m_use_regex)
            return std::regex_search(test_name.begin(), test_name.end(), m_regex);

        return test_name.contains(m_tags);
    }

    static bool is_runnable_test_name(std::string_view test_name)
    {
        return test_name.starts_with("scenario") or test_name.starts_with("test_case");
    }

    static bool has_hidden_tag(std::span<const std::string> tags)
    {
        // Catch2-style hidden tags: bracket tags starting with '.' (e.g. [.], [.jsonl-probe]).
        return std::ranges::any_of(tags, [](const auto& tag){ return tag.starts_with('.'); });
    }

    static std::vector<std::string> parse_tag_query(std::string_view query)
    {
        auto tags = std::vector<std::string>{};
        auto pos = std::size_t{0};

        while(pos < query.size())
        {
            if(query[pos] != '[')
                return {};

            auto end = query.find(']', pos + 1);
            if(end == std::string_view::npos)
                return {};

            tags.emplace_back(query.substr(pos + 1, end - pos - 1));
            pos = end + 1;
        }

        return tags;
    }

    bool match_literal_tags(std::span<const std::string> tags) const
    {
        if(m_literal_tags.empty())
            return true;

        return std::ranges::all_of(m_literal_tags, [tags](const auto& required){
            return std::ranges::contains(tags, required);
        });
    }

    bool excluded(const test_case& tc) const
    {
        return not included(tc);
    }
};

}
