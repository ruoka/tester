module;
#if defined(__GNUG__) && __has_include(<cxxabi.h>)
#   include <cxxabi.h>
#   define TESTER_HAVE_CXXABI 1
#else
#   define TESTER_HAVE_CXXABI 0
#endif

export module tester:utils;
import :data;
import :observer;
import std;

namespace tester::output
{

namespace
{

template<class T>
concept chrono_clock = requires {
    typename T::time_point;
    T::now();
};

}

export std::string demangle(std::string_view name)
{
#if TESTER_HAVE_CXXABI
    auto status = 0;
    auto buffer = std::string{name};
    auto demangled = abi::__cxa_demangle(buffer.c_str(), nullptr, nullptr, &status);
    if(demangled != nullptr)
    {
        auto result = std::string{demangled};
        std::free(demangled);
        return result;
    }
#endif
    return std::string{name};
}

// Demangle at the point where a type name is produced. Applying demangle() later, to
// whatever string reaches the reporting layer, corrupts ordinary test data that
// happens to look like a mangled symbol.
export std::string demangle_type(const std::type_info& info)
{
    return demangle(info.name());
}

// Bracket tags from scenario/test names, e.g. "scenario [fixer][board] ..." → ["fixer", "board"]
export std::vector<std::string> extract_bracket_tags(std::string_view test_name)
{
    auto tags = std::vector<std::string>{};
    auto pos = std::size_t{0};

    while((pos = test_name.find('[', pos)) != std::string_view::npos)
    {
        auto end = test_name.find(']', pos + 1);
        if(end == std::string_view::npos)
            break;

        tags.emplace_back(test_name.substr(pos + 1, end - pos - 1));
        pos = end + 1;
    }

    return tags;
}

// Extract matcher name from function name (e.g., "require_eq", "check_contains")
export auto extract_matcher_name(const std::source_location sl)
{
    using namespace std::literals;
    auto name = std::string_view{sl.function_name()};
    
    // Find "assertions::" prefix and extract the matcher name
    if(auto assertions_pos = name.find("assertions::"); assertions_pos != std::string_view::npos)
        name.remove_prefix(assertions_pos + "assertions::"s.length());
    
    // Extract base function name (before '(' or '<')
    auto end = name.find_first_of("(<");
    auto base = name.substr(0, end != std::string_view::npos ? end : name.size());
    
    return std::string{base};
}

export std::string display_matcher_name(const std::source_location sl)
{
    using namespace std::literals;
    auto name = std::string_view{sl.function_name()};

    if(auto assertions_pos = name.find("assertions::"); assertions_pos != std::string_view::npos)
        name.remove_prefix(assertions_pos + "assertions::"s.length());

    auto base = name.substr(0, name.find_first_of("("));
    auto display = std::string{base};

    if(auto bracket = name.find('['); bracket != std::string_view::npos)
    {
        auto end = name.find(']', bracket);
        auto parameters = end != std::string_view::npos
            ? name.substr(bracket + 1, end - bracket - 1)
            : name.substr(bracket + 1);

        auto trim = [](std::string_view value)
        {
            auto start = value.find_first_not_of(" \t");
            if(start == std::string_view::npos)
                return std::string_view{};
            auto finish = value.find_last_not_of(" \t");
            return value.substr(start, finish - start + 1);
        };

        auto clean = [](std::string text)
        {
            auto replace_all = [](std::string& target, std::string_view from, std::string_view to)
            {
                for(auto pos = target.find(from); pos != std::string::npos; pos = target.find(from, pos + to.size()))
                    target.replace(pos, from.size(), to);
            };

            replace_all(text, "std::__1::", "std::");
            replace_all(text, "std::basic_string<char>", "std::string");
            replace_all(text, "std::basic_string<wchar_t>", "std::wstring");
            replace_all(text, " >", ">");
            return text;
        };

        display.append(" [");
        auto remaining = parameters;
        auto first = true;
        while(true)
        {
            auto pos = remaining.find(',');
            auto token = trim(remaining.substr(0, pos));
            if(not token.empty())
            {
                if(not first)
                    display.append(", ");
                auto eq = token.find('=');
                if(eq != std::string_view::npos)
                {
                    display.append(trim(token.substr(0, eq)));
                    display.push_back('=');
                    display.append(demangle(clean(std::string{trim(token.substr(eq + 1))})));
                }
                else
                {
                    display.append(demangle(clean(std::string{token})));
                }
                first = false;
            }
            if(pos == std::string_view::npos)
                break;
            remaining.remove_prefix(pos + 1);
        }
        display.push_back(']');
    }

    return display;
}

// The character types, which both reporting channels have to treat apart from the other
// arithmetic ones: streamed as themselves they emit a raw byte, which is not readable on a
// console and not valid JSON. Spelled out because there is no trait for the set, and
// because the wide ones have no narrow stream inserter left to fall back on — C++20 deleted
// those overloads, so reaching this branch is what lets them be reported at all.
template<typename T>
constexpr bool is_character_v =
    std::is_same_v<T, char> or std::is_same_v<T, signed char> or std::is_same_v<T, unsigned char>
    or std::is_same_v<T, char8_t> or std::is_same_v<T, char16_t> or std::is_same_v<T, char32_t>
    or std::is_same_v<T, wchar_t>;

// Where a character can be shown as a glyph and nothing else has to be said about it. Not
// std::isprint: that classifies a byte, so it needs an unsigned char cast, and the cast
// truncates — char16_t{0x161} would arrive as 0x61 and be shown as 'a', a character the
// operand never held. It also follows the global locale, which can admit bytes from 0x80 up
// and would put a raw non-UTF-8 byte back in the output. The question here is about the
// value, which may be any code point up to 0x10ffff.
constexpr bool is_ascii_printable(auto code)
{
    return code >= 0x20 and code < 0x7f;
}

// A pair, a tuple, an array — the standard's tuple protocol, spelled as the protocol rather
// than as a list of types, so a user's own tuple-like type is covered. Exported because the
// comparison rule in tester:assertions asks the same question of the same types, and two
// answers could disagree about what a composite is.
export template<typename T>
constexpr bool is_tuple_like_v = requires { std::tuple_size<std::remove_cvref_t<T>>::value; };

// optional and expected both expose has_value / *, so error_type is what separates them.
// Exported with the tuple protocol: assertions unwrap these the way they walk composites,
// and the formatter has to show the contained value for a failure to be actionable.
export template<typename T>
constexpr bool is_optional_like_v =
    requires(const T& value) {
        typename T::value_type;
        { value.has_value() } -> std::convertible_to<bool>;
        { *value };
    } and not requires { typename T::error_type; };

export template<typename T>
constexpr bool is_expected_like_v =
    requires(const T& value) {
        typename T::value_type;
        typename T::error_type;
        { value.has_value() } -> std::convertible_to<bool>;
        { *value };
        { value.error() };
    };

// The same wraparound returns through wrappers that are neither tuple-like nor
// optional/expected: common_type with an integer decays to the integer (or builds a
// duration whose rep is unsigned), and equal_to then converts. Detect them by the
// protocol assertions unwrap, so a failure shows the referred / counted / loaded value.
export template<typename T>
constexpr bool is_reference_wrapper_v =
    requires(const T& value) {
        typename T::type;
        { value.get() } -> std::convertible_to<const typename T::type&>;
    };

export template<typename T>
constexpr bool is_duration_like_v =
    requires(const T& value) {
        typename T::rep;
        typename T::period;
        { value.count() } -> std::convertible_to<typename T::rep>;
    };

// unexpected has error() but no has_value — that is what separates it from expected.
// Do not require error_type: libc++'s unexpected omits the typedef the standard names,
// and requiring it left check_contains falling through to operator== (wraparound).
export template<typename T>
constexpr bool is_unexpected_like_v =
    requires(const T& value) {
        { value.error() };
    } and not requires(const T& value) {
        { value.has_value() } -> std::convertible_to<bool>;
    };

export template<typename T>
constexpr bool is_atomic_like_v =
    requires(const T& value) {
        typename T::value_type;
        { value.load() } -> std::convertible_to<typename T::value_type>;
    };

export template<typename V>
std::string value_to_display_string(const V& val)
{
    using T = std::remove_cvref_t<V>;
    auto stream = std::ostringstream{};

    // Strings are reported verbatim. Demangling here rewrote any test data shaped
    // like a mangled symbol — "_ZNSt6vectorIiEC1Ev" was displayed as
    // "std::vector<int>::vector()" — silently misreporting what the test compared.
    if constexpr (std::is_same_v<T, std::string>)
        stream << val;
    else if constexpr (std::is_same_v<T, std::string_view>)
        stream << val;
    else if constexpr (std::is_same_v<T, const char*> || std::is_same_v<T, char*>)
        stream << (val != nullptr ? std::string_view{val} : std::string_view{"nullptr"});
    else if constexpr (std::is_pointer_v<T>)
    {
        if(val != nullptr)
            stream << val;
        else
            stream << "nullptr";
    }
    else if constexpr (std::is_enum_v<T>)
        stream << std::to_underlying(val);
    else if constexpr (chrono_clock<T>)
        stream << std::format("{0:%F}T{0:%T}", val);
    else if constexpr (is_character_v<T>)
    {
        // Both forms, because either one alone hides something: streaming the character
        // put a raw byte on the console, so a failing check_eq(char{-1}, 4294967295u)
        // reported a replacement glyph with the -1 it compared nowhere in sight, while
        // the value alone turns an ordinary character comparison into 97 against 98.
        const auto code = +val;
        if(is_ascii_printable(code))
            stream << '\'' << static_cast<char>(code) << "' (" << code << ')';
        else
            stream << code;
    }
    else if constexpr (std::is_arithmetic_v<T>)
        stream << std::boolalpha << val;
    else if constexpr (requires { val.index(); })
    {
        if(std::holds_alternative<std::monostate>(val) || val.valueless_by_exception())
            stream << "null";
        else
            std::visit([&stream](const auto& alternative)
            {
                using alternative_type = std::decay_t<decltype(alternative)>;
                if constexpr (std::is_same_v<alternative_type, bool>)
                    stream << std::boolalpha << alternative;
                else if constexpr (std::is_same_v<alternative_type, std::nullptr_t>
                    || std::is_same_v<alternative_type, std::monostate>)
                    stream << "null";
                else if constexpr (std::is_same_v<alternative_type, std::string>
                    || std::is_same_v<alternative_type, std::string_view>)
                    stream << '"' << alternative << '"';
                else if constexpr (requires { stream << alternative; })
                    stream << alternative;
                else
                    stream << "...";
            }, val);
    }
    else if constexpr (is_tuple_like_v<T>)
    {
        // Members, by these same rules, since that is how they are compared. Naming the
        // type instead — `std::pair<unsigned long, int>` — left a failed pair comparison
        // with nothing about which member differed, or what either side held.
        stream << '(';
        [&]<std::size_t... member>(std::index_sequence<member...>)
        {
            using std::get;
            ((stream << (member == 0 ? "" : ", ") << value_to_display_string(get<member>(val))), ...);
        }(std::make_index_sequence<std::tuple_size_v<T>>{});
        stream << ')';
    }
    else if constexpr (is_optional_like_v<T>)
    {
        // The engaged value, or nullopt — naming the type alone hid the wraparound that
        // check_eq(optional{-1}, 4294967295u) used to accept.
        if(val.has_value())
            stream << value_to_display_string(*val);
        else
            stream << "nullopt";
    }
    else if constexpr (is_expected_like_v<T>)
    {
        if(val.has_value())
            stream << value_to_display_string(*val);
        else
            stream << "unexpected(" << value_to_display_string(val.error()) << ')';
    }
    else if constexpr (is_reference_wrapper_v<T>)
        stream << value_to_display_string(val.get());
    else if constexpr (is_duration_like_v<T>)
        stream << value_to_display_string(val.count());
    else if constexpr (is_unexpected_like_v<T>)
        stream << "unexpected(" << value_to_display_string(val.error()) << ')';
    else if constexpr (is_atomic_like_v<T>)
        stream << value_to_display_string(val.load());
    else if constexpr (requires { stream << val; })
        stream << std::boolalpha << val;
    else
        stream << "...";

    return stream.str();
}

export template <typename V>
observed_value observe_value(const V& val)
{
    using T = std::remove_cvref_t<V>;
    auto value = std::string{};
    auto kind = value_kind::text;

    if constexpr (std::is_same_v<T, std::string>)
        value = val;
    else if constexpr (std::is_same_v<T, std::string_view>)
        value = val;
    else if constexpr (std::is_same_v<T, const char*> || std::is_same_v<T, char*>)
        value = val != nullptr ? val : "nullptr";
    else if constexpr (std::is_pointer_v<T>)
    {
        if(val != nullptr)
        {
            const auto format_pointer = [](const auto& pointed)
            {
                if constexpr (requires(std::ostringstream& os, const std::decay_t<decltype(pointed)>& value) { os << value; })
                {
                    auto stream = std::ostringstream{};
                    stream << pointed;
                    return stream.str();
                }
                else
                {
                    return demangle_type(typeid(std::decay_t<decltype(pointed)>));
                }
            };
            value = format_pointer(*val);
        }
        else
            value = "nullptr";
    }
    else if constexpr (std::is_enum_v<T>)
    {
        value = std::to_string(std::to_underlying(val));
        kind = value_kind::number;
    }
    else if constexpr (is_character_v<T>)
    {
        // Promoted, so the value lands in a field the schema calls a number. Streamed as
        // itself the character went there raw — `"actual":a` for 'a', and a stray 0xff byte
        // for char{-1}, which is not even valid UTF-8 — leaving a line no parser could read,
        // and stdout is the whole contract with agents. Quoting it instead would lose the
        // value: escaping replaces a stray byte with U+FFFD, and char{-1} is exactly the
        // operand a mixed-signedness failure has to report. The console shows both forms.
        value = std::to_string(+val);
        kind = value_kind::number;
    }
    else if constexpr (std::is_arithmetic_v<T>)
    {
        if constexpr (std::is_same_v<T, bool>)
        {
            value = val ? "true" : "false";
            kind = value_kind::boolean;
        }
        else
        {
            auto stream = std::ostringstream{};
            stream << val;
            value = stream.str();
            kind = value_kind::number;
        }
    }
    else if constexpr (is_tuple_like_v<T>)
    {
        // Text rather than a type name: the members are what the comparison walked, so they
        // are what the stream has to carry for the failure to be actionable.
        value = value_to_display_string(val);
    }
    else if constexpr (is_optional_like_v<T> or is_expected_like_v<T>
        or is_reference_wrapper_v<T> or is_duration_like_v<T>
        or is_unexpected_like_v<T> or is_atomic_like_v<T>)
    {
        // Same reason as composites: the contained / counted / loaded value is what the
        // comparison walked (or unexpected(...)).
        value = value_to_display_string(val);
    }
    else
    {
        // A type the framework cannot print is reported by name, and a mangled name is
        // not a name anyone reads: exception types already go through demangle_type.
        value = demangle_type(typeid(T));
    }

    return observed_value{value_to_display_string(val), std::move(value), kind};
}

}
