export module tester:data;
import std;

namespace tester::data
{

export struct output_config
{
    std::size_t slowest = 0;
};

export struct test_metadata
{
    const std::string test_set_name;
    const std::string test_name;
    const std::string_view file_name;
    const std::uint_least32_t line;
    const std::uint_least32_t column;
    const std::string_view function_name;
    std::string test_id;  // Stable identifier for the test
};

using test = std::function<void(void)>;

struct test_case : public test_metadata
{
    test run = []{};
    int priority = 0;  // Lower numbers run first (default: 0)
    std::vector<std::string> depends_on;  // Test names this test depends on
    std::string id;  // Unique identifier for dependency references
    // Bracket tags, parsed once from the description at registration. Filtering and the
    // catalogue read these rather than re-parsing the rendered display name.
    std::vector<std::string> tags;
};

auto test_cases = std::list<test_case>{};

export struct test_result : public test_metadata
{
    bool success = true;
    std::string output = "";
    std::chrono::nanoseconds duration = std::chrono::nanoseconds{0};
    std::size_t assertions_ok = 0;
    std::size_t assertions_total = 0;
    std::chrono::system_clock::time_point started_at{};
    std::chrono::system_clock::time_point finished_at{};
};

auto test_results = std::list<test_result>{};

export struct test_statistics
{
    std::size_t successful_tests{0};
    std::size_t total_tests{0};
    std::size_t successful_assertions{0};
    std::size_t total_assertions{0};
    
    // Run metadata
    std::chrono::steady_clock::time_point run_started{};
    std::chrono::steady_clock::time_point run_finished{};
    std::chrono::system_clock::time_point run_started_unix_ms{};
    std::string run_tags{};
};

// Shared pass/fail verdict for exit status, summary.passed, and RESULT lines.
// A non-empty tag filter that matches nothing must fail — otherwise scoped CI
// runs (e.g. --tags='[typo]') silently pass via 0==0 totals.
export bool run_passed(const test_statistics& stats)
{
    if(not stats.run_tags.empty() and stats.total_tests == 0)
        return false;
    return stats.total_tests == stats.successful_tests
        and stats.total_assertions == stats.successful_assertions;
}

export inline test_statistics& statistics()
{
    static test_statistics stats{};
    return stats;
}

// Run-scoped state, alongside the run's other data. The runner writes it, the engine and the
// assertion matchers read it, and it is per-run rather than per-object — so it lives here
// instead of being threaded through every call that might eventually need it.
inline output_config g_config{};
inline std::vector<std::string> g_run_argv{};

// Which test an assertion belongs to. Thread-local because a test body may report from a
// thread it started, and that assertion still belongs to the test that spawned it.
inline thread_local std::string g_current_test_id{};

export const output_config& config()
{
    return g_config;
}

export void set_slowest(std::size_t n) { g_config.slowest = n; }

export std::span<const std::string> run_argv()
{
    return g_run_argv;
}

export void set_run_argv(int argc, char** argv)
{
    g_run_argv.clear();
    if(argc <= 0 || argv == nullptr)
        return;

    g_run_argv.reserve(static_cast<std::size_t>(argc));
    for(int i = 0; i < argc; ++i)
        g_run_argv.emplace_back(argv[i] != nullptr ? argv[i] : "");
}

export void set_current_test_id(std::string_view test_id) { g_current_test_id = std::string{test_id}; }
export std::string_view current_test_id() { return std::string_view{g_current_test_id}; }

}
