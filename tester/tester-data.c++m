export module tester:data;
import std;

namespace tester::data
{

export struct output_config
{
    std::size_t slowest = 0;
    // Top-level test workers. 1 = sequential (default); 0 = hardware_concurrency.
    std::size_t jobs = 1;
};

export struct test_metadata
{
    const std::string test_set_name;
    const std::string test_name;
    const std::string_view file_name;
    const std::uint_least32_t line;
    const std::uint_least32_t column;
    const std::string_view function_name;
    std::string test_id;  // Stable identifier for the test
};

using test = std::function<void(void)>;

struct test_case : public test_metadata
{
    test run = []{};
    int priority = 0;  // Lower numbers run first (default: 0)
    std::vector<std::string> depends_on;  // Test names this test depends on
    std::string id;  // Unique identifier for dependency references
    // Bracket tags, parsed once from the description at registration. Filtering and the
    // catalogue read these rather than re-parsing the rendered display name.
    std::vector<std::string> tags;
};

// Registration catalogue only — written at static init (and when a nested scenario /
// test_case is appended mid-run). Not per-execution state. Parallel workers take a
// mutex when appending mid-run so the scheduler can drain new cases safely.
auto test_cases = std::list<test_case>{};
inline std::mutex test_cases_mutex{};

export struct test_result : public test_metadata
{
    bool success = true;
    std::string output = "";
    std::chrono::nanoseconds duration = std::chrono::nanoseconds{0};
    std::size_t assertions_ok = 0;
    std::size_t assertions_total = 0;
    std::chrono::system_clock::time_point started_at{};
    std::chrono::system_clock::time_point finished_at{};
};

// Counters are atomic: a test may soft-assert from a thread it started, and under
// --jobs>1 those threads share the run-wide fallback context. Plain size_t lost
// updates there; observers already lock their own buffers.
export struct test_statistics
{
    std::atomic<std::size_t> successful_tests{0};
    std::atomic<std::size_t> total_tests{0};
    std::atomic<std::size_t> successful_assertions{0};
    std::atomic<std::size_t> total_assertions{0};

    // Run metadata — written from the run thread at start/end only.
    std::chrono::steady_clock::time_point run_started{};
    std::chrono::steady_clock::time_point run_finished{};
    std::chrono::system_clock::time_point run_started_unix_ms{};
    std::string run_tags{};

    test_statistics() = default;
    test_statistics(const test_statistics&) = delete;
    test_statistics& operator=(const test_statistics&) = delete;

    test_statistics(test_statistics&& other) noexcept
        : successful_tests{other.successful_tests.load(std::memory_order_relaxed)}
        , total_tests{other.total_tests.load(std::memory_order_relaxed)}
        , successful_assertions{other.successful_assertions.load(std::memory_order_relaxed)}
        , total_assertions{other.total_assertions.load(std::memory_order_relaxed)}
        , run_started{other.run_started}
        , run_finished{other.run_finished}
        , run_started_unix_ms{other.run_started_unix_ms}
        , run_tags{std::move(other.run_tags)}
    {
    }

    test_statistics& operator=(test_statistics&& other) noexcept
    {
        if(this != &other)
        {
            successful_tests.store(
                other.successful_tests.load(std::memory_order_relaxed), std::memory_order_relaxed);
            total_tests.store(
                other.total_tests.load(std::memory_order_relaxed), std::memory_order_relaxed);
            successful_assertions.store(
                other.successful_assertions.load(std::memory_order_relaxed), std::memory_order_relaxed);
            total_assertions.store(
                other.total_assertions.load(std::memory_order_relaxed), std::memory_order_relaxed);
            run_started = other.run_started;
            run_finished = other.run_finished;
            run_started_unix_ms = other.run_started_unix_ms;
            run_tags = std::move(other.run_tags);
        }
        return *this;
    }

    void reset_counts() noexcept
    {
        successful_tests.store(0, std::memory_order_relaxed);
        total_tests.store(0, std::memory_order_relaxed);
        successful_assertions.store(0, std::memory_order_relaxed);
        total_assertions.store(0, std::memory_order_relaxed);
    }

    void record_assertion(bool ok) noexcept
    {
        total_assertions.fetch_add(1, std::memory_order_relaxed);
        if(ok)
            successful_assertions.fetch_add(1, std::memory_order_relaxed);
    }

    void begin_assertion() noexcept
    {
        total_assertions.fetch_add(1, std::memory_order_relaxed);
    }

    void complete_assertion(bool ok) noexcept
    {
        if(ok)
            successful_assertions.fetch_add(1, std::memory_order_relaxed);
    }

    void merge_counts_from(test_statistics& other) noexcept
    {
        successful_tests.fetch_add(
            other.successful_tests.load(std::memory_order_relaxed), std::memory_order_relaxed);
        total_tests.fetch_add(
            other.total_tests.load(std::memory_order_relaxed), std::memory_order_relaxed);
        successful_assertions.fetch_add(
            other.successful_assertions.load(std::memory_order_relaxed), std::memory_order_relaxed);
        total_assertions.fetch_add(
            other.total_assertions.load(std::memory_order_relaxed), std::memory_order_relaxed);
    }
};

// Shared pass/fail verdict for exit status, summary.passed, and RESULT lines.
// A non-empty tag filter that matches nothing must fail — otherwise scoped CI
// runs (e.g. --tags='[typo]') silently pass via 0==0 totals.
export bool run_passed(const test_statistics& stats)
{
    if(not stats.run_tags.empty()
       and stats.total_tests.load(std::memory_order_relaxed) == 0)
        return false;
    return stats.total_tests.load(std::memory_order_relaxed)
            == stats.successful_tests.load(std::memory_order_relaxed)
        and stats.total_assertions.load(std::memory_order_relaxed)
            == stats.successful_assertions.load(std::memory_order_relaxed);
}

// Per-worker / per-run execution state. Everything that used to be a process-wide
// mutable global for "the case now running" lives here so parallel top-level runs
// can give each worker its own context without racing.
export struct execution_context
{
    std::function<bool(const test_case&)> excluded{};
    std::string current_test_id{};
    // Non-null while a case (or step) is collecting console text; nesting means the
    // case being started is a step of that one.
    std::string* current_output = nullptr;
    std::size_t step_assertions_total = 0;
    std::size_t step_assertions_ok = 0;
    test_statistics statistics{};
    std::list<test_result> results{};

    void set_test_id(std::string_view id) { current_test_id = std::string{id}; }
    void clear_test_id() { current_test_id.clear(); }
};

// Which execution context this thread reports into. Each parallel worker activates
// its own; nested scopes restore the previous pointer so a [self] probe can install
// a temporary context without losing the runner's.
inline thread_local execution_context* tls_execution = nullptr;

// Run-wide fallback for threads that never install an execution_scope. A test may
// assert from a thread it started (console observer / JSONL lock exist for that),
// and those threads do not inherit TLS — without this, statistics() throws and the
// worker hits std::terminate. The first scope that finds both slots empty binds it;
// nested scopes and later worker scopes leave it alone so they cannot steal the run.
inline execution_context* g_run_execution = nullptr;

export execution_context* active_execution() noexcept
{
    if(tls_execution != nullptr)
        return tls_execution;
    return g_run_execution;
}

export class execution_scope
{
public:
    explicit execution_scope(execution_context& context) noexcept
        : m_previous{tls_execution}
        , m_binds_run{tls_execution == nullptr and g_run_execution == nullptr}
    {
        tls_execution = &context;
        if(m_binds_run)
            g_run_execution = &context;
    }

    ~execution_scope()
    {
        tls_execution = m_previous;
        if(m_binds_run)
            g_run_execution = nullptr;
    }

    execution_scope(const execution_scope&) = delete;
    execution_scope& operator=(const execution_scope&) = delete;

private:
    execution_context* m_previous = nullptr;
    bool m_binds_run = false;
};

[[noreturn]] inline void require_active_execution(std::string_view api)
{
    throw std::logic_error{std::string{api} + " without an active execution_context"};
}

export test_statistics& statistics()
{
    if(auto* const ctx = active_execution(); ctx != nullptr)
        return ctx->statistics;
    require_active_execution("statistics()");
}

export std::list<test_result>& results()
{
    if(auto* const ctx = active_execution(); ctx != nullptr)
        return ctx->results;
    require_active_execution("results()");
}

// TLS only — child threads intentionally see an empty id, matching the pre-context
// thread_local current-test-id. Falling back to the run context here would attribute
// a late worker assert to whichever case the main thread had moved on to.
export std::string_view current_test_id()
{
    if(tls_execution == nullptr)
        return {};
    return tls_execution->current_test_id;
}

// Process-wide configuration written before a run starts (CLI), not per-case state.
inline output_config g_config{};
inline std::vector<std::string> g_run_argv{};

export const output_config& config()
{
    return g_config;
}

export void set_slowest(std::size_t n) { g_config.slowest = n; }

export void set_jobs(std::size_t n) { g_config.jobs = n; }

export std::size_t worker_count()
{
    if(g_config.jobs == 0)
    {
        const auto n = std::thread::hardware_concurrency();
        return n == 0 ? 1uz : static_cast<std::size_t>(n);
    }
    return std::max<std::size_t>(1, g_config.jobs);
}

export std::span<const std::string> run_argv()
{
    return g_run_argv;
}

export void set_run_argv(int argc, char** argv)
{
    g_run_argv.clear();
    if(argc <= 0 || argv == nullptr)
        return;

    g_run_argv.reserve(static_cast<std::size_t>(argc));
    for(int i = 0; i < argc; ++i)
        g_run_argv.emplace_back(argv[i] != nullptr ? argv[i] : "");
}

}
