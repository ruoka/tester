export module tester:assertions;
import :publisher;
import :data;
import :utils;
import std;

namespace tester::assertions
{
    using namespace std::literals;
    using data::test;
    using data::statistics;

    // Exception thrown by fatal assertions (require_*)
    export class assertion_failure : public std::exception
    {
    public:
        assertion_failure(std::string message) : m_message{std::move(message)} {}
        const char* what() const noexcept override { return m_message.c_str(); }
    private:
        std::string m_message;
    };

    // Check if type is a floating-point type
    template<typename T>
    constexpr bool is_floating_point_v = std::is_floating_point_v<T>;

    template<typename A, typename E>
    constexpr bool both_are_floating_point_v = is_floating_point_v<A> and is_floating_point_v<E>;

    // Types std::cmp_* can answer for once promoted. Passing bool, a character type or an
    // enumeration straight to cmp_* is ill-formed: it is specified over the signed and
    // unsigned integer types, which is not the set [basic.fundamental] calls integral
    // (/p11 versus /p2), and the standard offers no trait for the difference — the library
    // carries its own reserved-name equivalent for exactly this reason. Every one of those
    // types promotes to one cmp_* does accept, and unary + is that promotion, so the
    // comparators promote before they compare. Excluding them instead left the wraparound
    // in place for exactly the operands the exclusion named: check_eq(char{-1},
    // 4294967295u) reported equal.
    //
    // The set is spelled by category rather than by whether `+t` compiles, so a class type
    // with an overloaded unary + keeps its own operator==. Extended integer types such as
    // __int128 are admitted wherever the implementation accepts them.
    template<typename T>
    constexpr bool promotes_to_integer_v = std::integral<T> or (std::is_enum_v<T> and not std::is_scoped_enum_v<T>);

    // Same-type enumerations keep whatever comparison they have: promoting both sides
    // would bypass an operator== written for the enum. Against a number — or against a
    // different unscoped enumeration — there is no such operator in the ordinary case,
    // and the built-in / common_type comparison is the conversion that was wrong:
    // check_eq(legacy_flag::minus_one, other_flag::max) reported equal the same way
    // enum-vs-unsigned did. Two different promotable enumerations therefore take cmp_*
    // as well; only the same-type case is carved out.
    template<typename A, typename E>
    constexpr bool both_are_promotable_integers_v =
        promotes_to_integer_v<A> and promotes_to_integer_v<E>
        and (std::integral<A> or std::integral<E>
             or not std::is_same_v<std::remove_cvref_t<A>, std::remove_cvref_t<E>>);

    // Declared here and defined below with the container matchers that share them: the
    // composite walks call them, and they call the comparators the walks belong to.
    template<typename A, typename E> constexpr bool values_equal(const A& actual, const E& expected);
    template<typename A, typename E> constexpr bool values_less(const A& actual, const E& expected);

    // What a composite is, asked once for the whole framework: tester:utils needs the same
    // answer to know a pair reads as its members.
    using output::is_tuple_like_v;
    using output::is_optional_like_v;
    using output::is_expected_like_v;
    using output::is_reference_wrapper_v;
    using output::is_duration_like_v;
    using output::is_unexpected_like_v;
    using output::is_atomic_like_v;
    using output::is_nullopt_v;
    using output::is_time_point_like_v;

    // Arity is asked only once both sides are tuple-like: tuple_size_v on anything else is
    // an error rather than a false. Two composites of different length fall through to the
    // ordinary comparator, which is where they were before.
    template<typename A, typename E>
    constexpr bool composites_of_equal_arity()
    {
        if constexpr (is_tuple_like_v<A> and is_tuple_like_v<E>)
            return std::tuple_size_v<std::remove_cvref_t<A>> == std::tuple_size_v<std::remove_cvref_t<E>>;
        else
            return false;
    }

    template<typename A, typename E>
    constexpr bool both_are_tuple_like_v = composites_of_equal_arity<A,E>();

    // The scalar rule reaches into composites, because a heterogeneous pair or tuple has a
    // common type of its own: comparing through it converted every member the way scalars
    // used to be converted, and check_eq(pair{npos, 0}, pair{-1L, 0}) reported equal.
    // Members go through values_equal, so a member that is itself a composite is walked
    // again and the epsilon reaches a floating-point member.
    template<typename A, typename E>
    constexpr bool tuple_values_equal(const A& actual, const E& expected)
    {
        using std::get;
        return [&]<std::size_t... member>(std::index_sequence<member...>) {
            return (values_equal(get<member>(actual), get<member>(expected)) and ...);
        }(std::make_index_sequence<std::tuple_size_v<std::remove_cvref_t<A>>>{});
    }

    // Lexicographic, by the same per-member rule: the first member that orders decides, and
    // one that orders neither way is a tie. Deliberately no equality in the tie-break — a
    // member that is neither less nor greater ties whatever equality would say, which keeps
    // the epsilon out of ordering here exactly as it is for scalars.
    template<std::size_t member = 0, typename A, typename E>
    constexpr bool tuple_values_less(const A& actual, const E& expected)
    {
        if constexpr (member == std::tuple_size_v<std::remove_cvref_t<A>>)
            return false;
        else
        {
            using std::get;
            if(values_less(get<member>(actual), get<member>(expected)))
                return true;
            if(values_less(get<member>(expected), get<member>(actual)))
                return false;
            return tuple_values_less<member + 1>(actual, expected);
        }
    }

    // optional and expected are not tuple-like, so the composite walk never reached them.
    // Their common_type with a bare integer is the wrapper itself, and constructing that
    // wrapper from the integer reintroduced the wraparound: check_eq(optional{-1},
    // 4294967295u) built optional{unsigned(-1)} and reported equal. Unwrap to the
    // contained value and apply the scalar rule there; engagement must match first.
    // nullopt is a partner of optional (common_type is the optional), so treat it as
    // disengaged rather than attempting *optional against nullopt_t.
    template<typename A, typename E>
    constexpr bool optional_values_equal(const A& actual, const E& expected)
    {
        if constexpr (is_optional_like_v<A> and is_optional_like_v<E>)
        {
            if(actual.has_value() != expected.has_value())
                return false;
            if(not actual.has_value())
                return true;
            return values_equal(*actual, *expected);
        }
        else if constexpr (is_optional_like_v<A> and is_nullopt_v<E>)
            return not actual.has_value();
        else if constexpr (is_nullopt_v<A> and is_optional_like_v<E>)
            return not expected.has_value();
        else if constexpr (is_optional_like_v<A>)
            return actual.has_value() and values_equal(*actual, expected);
        else
            return expected.has_value() and values_equal(actual, *expected);
    }

    // nullopt is less than any engaged value, matching std::optional's ordering; engaged
    // values go through values_less. nullopt compared with a disengaged optional is a tie.
    template<typename A, typename E>
    constexpr bool optional_values_less(const A& actual, const E& expected)
    {
        if constexpr (is_optional_like_v<A> and is_optional_like_v<E>)
        {
            if(not actual.has_value())
                return expected.has_value();
            if(not expected.has_value())
                return false;
            return values_less(*actual, *expected);
        }
        else if constexpr (is_optional_like_v<A> and is_nullopt_v<E>)
            return false;
        else if constexpr (is_nullopt_v<A> and is_optional_like_v<E>)
            return expected.has_value();
        else if constexpr (is_optional_like_v<A>)
            return not actual.has_value() or values_less(*actual, expected);
        else
            return expected.has_value() and values_less(actual, *expected);
    }

    // Same unwrap for expected: value-to-value and error-to-error through values_equal;
    // a value compared with a bare operand only when the expected holds a value, as
    // std::expected's own operator== does. expected<void, E> has no contained value to
    // pass to values_equal — *e is a void expression — so two engaged voids compare equal
    // without unwrapping, matching operator== before the unwrap path existed.
    // unexpected is also a partner (common_type is the expected): match disengaged and
    // compare errors, rather than treating unexpected as a bare value operand.
    template<typename A, typename E>
    constexpr bool expected_values_equal(const A& actual, const E& expected)
    {
        if constexpr (is_expected_like_v<A> and is_expected_like_v<E>)
        {
            if(actual.has_value() != expected.has_value())
                return false;
            if(not actual.has_value())
                return values_equal(actual.error(), expected.error());
            if constexpr (std::is_void_v<typename std::remove_cvref_t<A>::value_type>
                      and std::is_void_v<typename std::remove_cvref_t<E>::value_type>)
                return true;
            else if constexpr (std::is_void_v<typename std::remove_cvref_t<A>::value_type>
                            or std::is_void_v<typename std::remove_cvref_t<E>::value_type>)
                return false;
            else
                return values_equal(*actual, *expected);
        }
        else if constexpr (is_expected_like_v<A>)
        {
            if constexpr (is_unexpected_like_v<E>)
                return not actual.has_value()
                    and values_equal(actual.error(), expected.error());
            else if constexpr (std::is_void_v<typename std::remove_cvref_t<A>::value_type>)
                return false;
            else
                return actual.has_value() and values_equal(*actual, expected);
        }
        else
        {
            if constexpr (is_unexpected_like_v<A>)
                return not expected.has_value()
                    and values_equal(actual.error(), expected.error());
            else if constexpr (std::is_void_v<typename std::remove_cvref_t<E>::value_type>)
                return false;
            else
                return expected.has_value() and values_equal(actual, *expected);
        }
    }

    // Unexpected is less than a value (has_value false < true); matching sides unwrap.
    // Engaged void has nothing to order through values_less — two voids are equal, not less.
    // An unexpected partner converts like a disengaged expected: compare errors, or lose to
    // an engaged value.
    template<typename A, typename E>
    constexpr bool expected_values_less(const A& actual, const E& expected)
    {
        if constexpr (is_expected_like_v<A> and is_expected_like_v<E>)
        {
            if(actual.has_value() != expected.has_value())
                return not actual.has_value() and expected.has_value();
            if(not actual.has_value())
                return values_less(actual.error(), expected.error());
            if constexpr (std::is_void_v<typename std::remove_cvref_t<A>::value_type>
                       or std::is_void_v<typename std::remove_cvref_t<E>::value_type>)
                return false;
            else
                return values_less(*actual, *expected);
        }
        else if constexpr (is_expected_like_v<A>)
        {
            if constexpr (is_unexpected_like_v<E>)
            {
                if(actual.has_value())
                    return false;
                return values_less(actual.error(), expected.error());
            }
            else if constexpr (std::is_void_v<typename std::remove_cvref_t<A>::value_type>)
                return not actual.has_value();
            else
                return not actual.has_value() or values_less(*actual, expected);
        }
        else
        {
            if constexpr (is_unexpected_like_v<A>)
            {
                if(not expected.has_value())
                    return values_less(actual.error(), expected.error());
                return true;
            }
            else if constexpr (std::is_void_v<typename std::remove_cvref_t<E>::value_type>)
                return false;
            else
                return expected.has_value() and values_less(actual, *expected);
        }
    }

    // reference_wrapper's common_type with an integer is the integer, so equal_to converts
    // through the referred type and reintroduces the wraparound. Unwrap with get().
    template<typename A, typename E>
    constexpr bool reference_wrapper_values_equal(const A& actual, const E& expected)
    {
        if constexpr (is_reference_wrapper_v<A> and is_reference_wrapper_v<E>)
            return values_equal(actual.get(), expected.get());
        else if constexpr (is_reference_wrapper_v<A>)
            return values_equal(actual.get(), expected);
        else
            return values_equal(actual, expected.get());
    }

    template<typename A, typename E>
    constexpr bool reference_wrapper_values_less(const A& actual, const E& expected)
    {
        if constexpr (is_reference_wrapper_v<A> and is_reference_wrapper_v<E>)
            return values_less(actual.get(), expected.get());
        else if constexpr (is_reference_wrapper_v<A>)
            return values_less(actual.get(), expected);
        else
            return values_less(actual, expected.get());
    }

    // Two durations of differently signed reps have a common_type whose rep is unsigned,
    // so comparing through it (or via duration's own operator==) wraps the signed count.
    // Compare the tick counts with the scalar rule. Same period is the direct count.
    // Different periods: floating reps keep chrono's floating common_type (widening to
    // intmax_t is ill-formed — chrono refuses float→int truncation — and broke
    // check_eq(1.5ms, 1500us)); integer reps widen to intmax_t first so the common
    // conversion cannot pick an unsigned rep and wrap -1 into max again.
    template<typename A, typename E>
    constexpr bool duration_values_equal(const A& actual, const E& expected)
    {
        if constexpr (is_duration_like_v<A> and is_duration_like_v<E>)
        {
            if constexpr (std::ratio_equal_v<typename A::period, typename E::period>)
                return values_equal(actual.count(), expected.count());
            else if constexpr (std::chrono::treat_as_floating_point_v<typename A::rep>
                            or std::chrono::treat_as_floating_point_v<typename E::rep>)
            {
                using common = std::common_type_t<A, E>;
                return values_equal(common{actual}.count(), common{expected}.count());
            }
            else
            {
                using wide_a = std::chrono::duration<std::intmax_t, typename A::period>;
                using wide_e = std::chrono::duration<std::intmax_t, typename E::period>;
                using common = std::common_type_t<wide_a, wide_e>;
                return values_equal(common{wide_a{actual}}.count(),
                                    common{wide_e{expected}}.count());
            }
        }
        else if constexpr (is_duration_like_v<A>)
            return values_equal(actual.count(), expected);
        else
            return values_equal(actual, expected.count());
    }

    template<typename A, typename E>
    constexpr bool duration_values_less(const A& actual, const E& expected)
    {
        if constexpr (is_duration_like_v<A> and is_duration_like_v<E>)
        {
            if constexpr (std::ratio_equal_v<typename A::period, typename E::period>)
                return values_less(actual.count(), expected.count());
            else if constexpr (std::chrono::treat_as_floating_point_v<typename A::rep>
                            or std::chrono::treat_as_floating_point_v<typename E::rep>)
            {
                using common = std::common_type_t<A, E>;
                return values_less(common{actual}.count(), common{expected}.count());
            }
            else
            {
                using wide_a = std::chrono::duration<std::intmax_t, typename A::period>;
                using wide_e = std::chrono::duration<std::intmax_t, typename E::period>;
                using common = std::common_type_t<wide_a, wide_e>;
                return values_less(common{wide_a{actual}}.count(),
                                   common{wide_e{expected}}.count());
            }
        }
        else if constexpr (is_duration_like_v<A>)
            return values_less(actual.count(), expected);
        else
            return values_less(actual, expected.count());
    }

    // time_point is not duration-like, but two points whose duration reps differ in
    // signedness still share a common_type: equal_to / operator== then compare epochs
    // through an unsigned common duration and wrap -1 into max. Compare epoch tick
    // counts with the scalar rule. Same period is the direct count; different periods
    // mirror duration_values_* (floating common_type vs intmax_t widen for integers).
    template<typename A, typename E>
    constexpr bool time_point_values_equal(const A& actual, const E& expected)
    {
        if constexpr (is_time_point_like_v<A> and is_time_point_like_v<E>)
        {
            using duration_a = typename A::duration;
            using duration_e = typename E::duration;
            if constexpr (std::ratio_equal_v<typename duration_a::period, typename duration_e::period>)
                return values_equal(actual.time_since_epoch().count(),
                                    expected.time_since_epoch().count());
            else if constexpr (std::chrono::treat_as_floating_point_v<typename duration_a::rep>
                            or std::chrono::treat_as_floating_point_v<typename duration_e::rep>)
            {
                using common = std::common_type_t<duration_a, duration_e>;
                return values_equal(common{actual.time_since_epoch()}.count(),
                                    common{expected.time_since_epoch()}.count());
            }
            else
            {
                using wide_a = std::chrono::duration<std::intmax_t, typename duration_a::period>;
                using wide_e = std::chrono::duration<std::intmax_t, typename duration_e::period>;
                using common = std::common_type_t<wide_a, wide_e>;
                return values_equal(common{wide_a{actual.time_since_epoch()}}.count(),
                                    common{wide_e{expected.time_since_epoch()}}.count());
            }
        }
        else if constexpr (is_time_point_like_v<A>)
            return values_equal(actual.time_since_epoch().count(), expected);
        else
            return values_equal(actual, expected.time_since_epoch().count());
    }

    template<typename A, typename E>
    constexpr bool time_point_values_less(const A& actual, const E& expected)
    {
        if constexpr (is_time_point_like_v<A> and is_time_point_like_v<E>)
        {
            using duration_a = typename A::duration;
            using duration_e = typename E::duration;
            if constexpr (std::ratio_equal_v<typename duration_a::period, typename duration_e::period>)
                return values_less(actual.time_since_epoch().count(),
                                   expected.time_since_epoch().count());
            else if constexpr (std::chrono::treat_as_floating_point_v<typename duration_a::rep>
                            or std::chrono::treat_as_floating_point_v<typename duration_e::rep>)
            {
                using common = std::common_type_t<duration_a, duration_e>;
                return values_less(common{actual.time_since_epoch()}.count(),
                                   common{expected.time_since_epoch()}.count());
            }
            else
            {
                using wide_a = std::chrono::duration<std::intmax_t, typename duration_a::period>;
                using wide_e = std::chrono::duration<std::intmax_t, typename duration_e::period>;
                using common = std::common_type_t<wide_a, wide_e>;
                return values_less(common{wide_a{actual.time_since_epoch()}}.count(),
                                   common{wide_e{expected.time_since_epoch()}}.count());
            }
        }
        else if constexpr (is_time_point_like_v<A>)
            return values_less(actual.time_since_epoch().count(), expected);
        else
            return values_less(actual, expected.time_since_epoch().count());
    }

    // unexpected is not expected-like (no has_value). Its operator== compares errors with
    // the built-in conversion, so a container of unexpected<int> still matched
    // unexpected<unsigned>{max}. Unwrap the error.
    template<typename A, typename E>
    constexpr bool unexpected_values_equal(const A& actual, const E& expected)
    {
        if constexpr (is_unexpected_like_v<A> and is_unexpected_like_v<E>)
            return values_equal(actual.error(), expected.error());
        else if constexpr (is_unexpected_like_v<A>)
            return values_equal(actual.error(), expected);
        else
            return values_equal(actual, expected.error());
    }

    template<typename A, typename E>
    constexpr bool unexpected_values_less(const A& actual, const E& expected)
    {
        if constexpr (is_unexpected_like_v<A> and is_unexpected_like_v<E>)
            return values_less(actual.error(), expected.error());
        else if constexpr (is_unexpected_like_v<A>)
            return values_less(actual.error(), expected);
        else
            return values_less(actual, expected.error());
    }

    // atomic's operator== loads then converts. Load first so mixed signedness hits cmp_*.
    template<typename A, typename E>
    constexpr bool atomic_values_equal(const A& actual, const E& expected)
    {
        if constexpr (is_atomic_like_v<A> and is_atomic_like_v<E>)
            return values_equal(actual.load(), expected.load());
        else if constexpr (is_atomic_like_v<A>)
            return values_equal(actual.load(), expected);
        else
            return values_equal(actual, expected.load());
    }

    template<typename A, typename E>
    constexpr bool atomic_values_less(const A& actual, const E& expected)
    {
        if constexpr (is_atomic_like_v<A> and is_atomic_like_v<E>)
            return values_less(actual.load(), expected.load());
        else if constexpr (is_atomic_like_v<A>)
            return values_less(actual.load(), expected);
        else
            return values_less(actual, expected.load());
    }

    // Floating-point comparator with epsilon tolerance
    template<typename T>
    requires std::is_floating_point_v<T>
    struct floating_point_equal
    {
        // A flat 1e-9 is unreachable for float, whose machine epsilon (~1.19e-7) is
        // larger: a few ulps of ordinary rounding error would compare unequal. Floor
        // the default at four ulps; double and long double keep the historical 1e-9.
        static constexpr T default_epsilon = std::max(T{1e-9}, std::numeric_limits<T>::epsilon() * T{4});
        
        explicit floating_point_equal(T epsilon = default_epsilon) : m_epsilon(epsilon) {}
        
        bool operator()(T a, T b) const
        {
            // Handle infinities and NaNs
            if(std::isinf(a) or std::isinf(b))
                return a == b;
            if(std::isnan(a) or std::isnan(b))
                return std::isnan(a) and std::isnan(b);
            
            // Use relative tolerance for large numbers, absolute for small
            const auto diff = std::abs(a - b);
            const auto max_val = std::max(std::abs(a), std::abs(b));
            
            // Relative tolerance: compare with scaled epsilon
            if(max_val > T{1.0})
                return diff <= max_val * m_epsilon;
            
            // Absolute tolerance: for small values, use epsilon directly
            return diff <= m_epsilon;
        }
        
    private:
        T m_epsilon;
    };

    // Comparators mirroring the std ones, and the single home for every type-dependent
    // comparison rule, so that each matcher is the same one-line shape: name the
    // comparator, instantiate it on the common type, pass the operands as written.
    //
    //   - floating point compares within an epsilon, for equality only. Ordering stays
    //     exact, as it is in every framework; check_near takes an explicit tolerance.
    //   - integers, promoted, compare as mathematical values through std::cmp_*
    //   - everything else uses the std comparator on the common type, as before
    //
    // Integers are the reason this layer exists. std::common_type_t<int,unsigned> is
    // unsigned, so comparing through it converted -1 to 4294967295 and check_eq(-1,
    // 4294967295u) reported equal; std::equal_to, std::ranges::equal_to and the built-in
    // operators all convert the same way. std::cmp_* answers correctly but ships as
    // function templates rather than function objects, so this adaptation is what the
    // matchers need. Matching signedness needs no special case, since std::cmp_equal is
    // then specified as plain t == u, which makes the integer path exact for every pair.
    //
    // Each call operator is a template so the operands arrive with their own types:
    // converting them is the bug. Conversion to T still happens on the other two paths,
    // in the parameters of the comparator being delegated to, where it is harmless — a
    // float widened to the common type is lossless, and it is what the ordinary
    // comparators did all along.

    template<typename T> struct numeric_equal_to
    {
        template<typename A, typename E>
        constexpr bool operator()(const A& actual, const E& expected) const
        {
            if constexpr (both_are_floating_point_v<A,E>) return floating_point_equal<T>{}(actual, expected);
            else if constexpr (both_are_promotable_integers_v<A,E>) return std::cmp_equal(+actual, +expected);
            else if constexpr (both_are_tuple_like_v<A,E>) return tuple_values_equal(actual, expected);
            else if constexpr (is_optional_like_v<A> or is_optional_like_v<E>) return optional_values_equal(actual, expected);
            else if constexpr (is_expected_like_v<A> or is_expected_like_v<E>) return expected_values_equal(actual, expected);
            else if constexpr (is_reference_wrapper_v<A> or is_reference_wrapper_v<E>) return reference_wrapper_values_equal(actual, expected);
            else if constexpr (is_duration_like_v<A> or is_duration_like_v<E>) return duration_values_equal(actual, expected);
            else if constexpr (is_time_point_like_v<A> or is_time_point_like_v<E>) return time_point_values_equal(actual, expected);
            else if constexpr (is_unexpected_like_v<A> or is_unexpected_like_v<E>) return unexpected_values_equal(actual, expected);
            else if constexpr (is_atomic_like_v<A> or is_atomic_like_v<E>) return atomic_values_equal(actual, expected);
            else return std::equal_to<T>{}(actual, expected);
        }
    };

    template<typename T> struct numeric_not_equal_to
    {
        template<typename A, typename E>
        constexpr bool operator()(const A& actual, const E& expected) const
        {
            // The epsilon has to appear here too, negated: while this compared floating
            // point exactly, two values within the tolerance satisfied check_eq and
            // check_neq at the same time.
            if constexpr (both_are_floating_point_v<A,E>) return not floating_point_equal<T>{}(actual, expected);
            else if constexpr (both_are_promotable_integers_v<A,E>) return std::cmp_not_equal(+actual, +expected);
            else if constexpr (both_are_tuple_like_v<A,E>) return not tuple_values_equal(actual, expected);
            else if constexpr (is_optional_like_v<A> or is_optional_like_v<E>) return not optional_values_equal(actual, expected);
            else if constexpr (is_expected_like_v<A> or is_expected_like_v<E>) return not expected_values_equal(actual, expected);
            else if constexpr (is_reference_wrapper_v<A> or is_reference_wrapper_v<E>) return not reference_wrapper_values_equal(actual, expected);
            else if constexpr (is_duration_like_v<A> or is_duration_like_v<E>) return not duration_values_equal(actual, expected);
            else if constexpr (is_time_point_like_v<A> or is_time_point_like_v<E>) return not time_point_values_equal(actual, expected);
            else if constexpr (is_unexpected_like_v<A> or is_unexpected_like_v<E>) return not unexpected_values_equal(actual, expected);
            else if constexpr (is_atomic_like_v<A> or is_atomic_like_v<E>) return not atomic_values_equal(actual, expected);
            else return std::not_equal_to<T>{}(actual, expected);
        }
    };

    template<typename T> struct numeric_less
    {
        template<typename A, typename E>
        constexpr bool operator()(const A& actual, const E& expected) const
        {
            if constexpr (both_are_promotable_integers_v<A,E>) return std::cmp_less(+actual, +expected);
            else if constexpr (both_are_tuple_like_v<A,E>) return tuple_values_less(actual, expected);
            else if constexpr (is_optional_like_v<A> or is_optional_like_v<E>) return optional_values_less(actual, expected);
            else if constexpr (is_expected_like_v<A> or is_expected_like_v<E>) return expected_values_less(actual, expected);
            else if constexpr (is_reference_wrapper_v<A> or is_reference_wrapper_v<E>) return reference_wrapper_values_less(actual, expected);
            else if constexpr (is_duration_like_v<A> or is_duration_like_v<E>) return duration_values_less(actual, expected);
            else if constexpr (is_time_point_like_v<A> or is_time_point_like_v<E>) return time_point_values_less(actual, expected);
            else if constexpr (is_unexpected_like_v<A> or is_unexpected_like_v<E>) return unexpected_values_less(actual, expected);
            else if constexpr (is_atomic_like_v<A> or is_atomic_like_v<E>) return atomic_values_less(actual, expected);
            else return std::less<T>{}(actual, expected);
        }
    };

    template<typename T> struct numeric_less_equal
    {
        template<typename A, typename E>
        constexpr bool operator()(const A& actual, const E& expected) const
        {
            if constexpr (both_are_promotable_integers_v<A,E>) return std::cmp_less_equal(+actual, +expected);
            else if constexpr (both_are_tuple_like_v<A,E>) return not tuple_values_less(expected, actual);
            else if constexpr (is_optional_like_v<A> or is_optional_like_v<E>) return not optional_values_less(expected, actual);
            else if constexpr (is_expected_like_v<A> or is_expected_like_v<E>) return not expected_values_less(expected, actual);
            else if constexpr (is_reference_wrapper_v<A> or is_reference_wrapper_v<E>) return not reference_wrapper_values_less(expected, actual);
            else if constexpr (is_duration_like_v<A> or is_duration_like_v<E>) return not duration_values_less(expected, actual);
            else if constexpr (is_time_point_like_v<A> or is_time_point_like_v<E>) return not time_point_values_less(expected, actual);
            else if constexpr (is_unexpected_like_v<A> or is_unexpected_like_v<E>) return not unexpected_values_less(expected, actual);
            else if constexpr (is_atomic_like_v<A> or is_atomic_like_v<E>) return not atomic_values_less(expected, actual);
            else return std::less_equal<T>{}(actual, expected);
        }
    };

    template<typename T> struct numeric_greater
    {
        template<typename A, typename E>
        constexpr bool operator()(const A& actual, const E& expected) const
        {
            if constexpr (both_are_promotable_integers_v<A,E>) return std::cmp_greater(+actual, +expected);
            else if constexpr (both_are_tuple_like_v<A,E>) return tuple_values_less(expected, actual);
            else if constexpr (is_optional_like_v<A> or is_optional_like_v<E>) return optional_values_less(expected, actual);
            else if constexpr (is_expected_like_v<A> or is_expected_like_v<E>) return expected_values_less(expected, actual);
            else if constexpr (is_reference_wrapper_v<A> or is_reference_wrapper_v<E>) return reference_wrapper_values_less(expected, actual);
            else if constexpr (is_duration_like_v<A> or is_duration_like_v<E>) return duration_values_less(expected, actual);
            else if constexpr (is_time_point_like_v<A> or is_time_point_like_v<E>) return time_point_values_less(expected, actual);
            else if constexpr (is_unexpected_like_v<A> or is_unexpected_like_v<E>) return unexpected_values_less(expected, actual);
            else if constexpr (is_atomic_like_v<A> or is_atomic_like_v<E>) return atomic_values_less(expected, actual);
            else return std::greater<T>{}(actual, expected);
        }
    };

    template<typename T> struct numeric_greater_equal
    {
        template<typename A, typename E>
        constexpr bool operator()(const A& actual, const E& expected) const
        {
            if constexpr (both_are_promotable_integers_v<A,E>) return std::cmp_greater_equal(+actual, +expected);
            else if constexpr (both_are_tuple_like_v<A,E>) return not tuple_values_less(actual, expected);
            else if constexpr (is_optional_like_v<A> or is_optional_like_v<E>) return not optional_values_less(actual, expected);
            else if constexpr (is_expected_like_v<A> or is_expected_like_v<E>) return not expected_values_less(actual, expected);
            else if constexpr (is_reference_wrapper_v<A> or is_reference_wrapper_v<E>) return not reference_wrapper_values_less(actual, expected);
            else if constexpr (is_duration_like_v<A> or is_duration_like_v<E>) return not duration_values_less(actual, expected);
            else if constexpr (is_time_point_like_v<A> or is_time_point_like_v<E>) return not time_point_values_less(actual, expected);
            else if constexpr (is_unexpected_like_v<A> or is_unexpected_like_v<E>) return not unexpected_values_less(actual, expected);
            else if constexpr (is_atomic_like_v<A> or is_atomic_like_v<E>) return not atomic_values_less(actual, expected);
            else return std::greater_equal<T>{}(actual, expected);
        }
    };

    // The element rule for the container matchers, so that a container of numbers answers
    // the way its elements would answer on their own. Comparing elements with `==` left the
    // container matchers converting where check_eq had stopped: check_contains(
    // std::vector<std::size_t>{std::string::npos}, -1) passed, and so did
    // check_container_eq({-1}, {4294967295u}). Elements go through the same comparator, so
    // the epsilon applies to floating point here too. Element types with no common type
    // keep their own operator==, which is all std::common_type_t would have to work with —
    // except the wrappers that unwrap here the same way the matchers do (optional, expected,
    // reference_wrapper, duration, time_point, unexpected, atomic), so a missing common_type
    // cannot fall back into the wraparound their operator== still has.
    template<typename A, typename E>
    constexpr bool values_equal(const A& actual, const E& expected)
    {
        if constexpr (requires { typename std::common_type<A,E>::type; })
            return numeric_equal_to<std::common_type_t<A,E>>{}(actual, expected);
        else if constexpr (is_optional_like_v<A> or is_optional_like_v<E>)
            return optional_values_equal(actual, expected);
        else if constexpr (is_expected_like_v<A> or is_expected_like_v<E>)
            return expected_values_equal(actual, expected);
        else if constexpr (is_reference_wrapper_v<A> or is_reference_wrapper_v<E>)
            return reference_wrapper_values_equal(actual, expected);
        else if constexpr (is_duration_like_v<A> or is_duration_like_v<E>)
            return duration_values_equal(actual, expected);
        else if constexpr (is_time_point_like_v<A> or is_time_point_like_v<E>)
            return time_point_values_equal(actual, expected);
        else if constexpr (is_unexpected_like_v<A> or is_unexpected_like_v<E>)
            return unexpected_values_equal(actual, expected);
        else if constexpr (is_atomic_like_v<A> or is_atomic_like_v<E>)
            return atomic_values_equal(actual, expected);
        else
            return actual == expected;
    }

    // The ordering counterpart, for the composite walk: same rule, same fallback.
    template<typename A, typename E>
    constexpr bool values_less(const A& actual, const E& expected)
    {
        if constexpr (requires { typename std::common_type<A,E>::type; })
            return numeric_less<std::common_type_t<A,E>>{}(actual, expected);
        else if constexpr (is_optional_like_v<A> or is_optional_like_v<E>)
            return optional_values_less(actual, expected);
        else if constexpr (is_expected_like_v<A> or is_expected_like_v<E>)
            return expected_values_less(actual, expected);
        else if constexpr (is_reference_wrapper_v<A> or is_reference_wrapper_v<E>)
            return reference_wrapper_values_less(actual, expected);
        else if constexpr (is_duration_like_v<A> or is_duration_like_v<E>)
            return duration_values_less(actual, expected);
        else if constexpr (is_time_point_like_v<A> or is_time_point_like_v<E>)
            return time_point_values_less(actual, expected);
        else if constexpr (is_unexpected_like_v<A> or is_unexpected_like_v<E>)
            return unexpected_values_less(actual, expected);
        else if constexpr (is_atomic_like_v<A> or is_atomic_like_v<E>)
            return atomic_values_less(actual, expected);
        else
            return actual < expected;
    }

    // Operands are taken by forwarding reference and only ever read: the comparator and
    // the publisher both take them by const reference, so nothing is forwarded onward and
    // nothing is consumed. By value copied each operand once per layer, which ruled out
    // move-only types entirely. A plain const A& would not do, because deduction against
    // it drops the const of a string literal's element type — A becomes char[4], whose
    // common type is char*, which cannot hold the const char* the literal decays to.
    // std::common_type_t already decays, so it yields the same T the by-value parameters
    // did, and every comparator still sees exactly the type it saw before.

    // Arrays are the one kind of operand that has to be decayed here. A forwarding
    // reference preserves char[N] where a by-value parameter produced const char*, and
    // both layers below expect the pointer: the comparator is instantiated on
    // std::common_type_t, which is the decayed type, so a non-const array cannot bind to
    // it at all, and the publisher reports a pointer as its characters but an array as its
    // type name. Everything else is forwarded untouched.
    template<typename T>
    constexpr decltype(auto) decayed(T&& value)
    {
        if constexpr (std::is_array_v<std::remove_reference_t<T>>)
            return static_cast<std::decay_t<T>>(value);
        else
            return std::forward<T>(value);
    }

    // Non-fatal assertion helper (check_*)
    export template<template <typename> class M, typename A, typename E>
    auto check(M<std::common_type_t<A,E>> match, A&& actual, E&& expected, const std::source_location location = std::source_location::current(), const std::source_location matcher_location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        const auto ok = match(decayed(actual),decayed(expected));
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok,decayed(actual),decayed(expected),location,matcher_location);
        return ok;
    };

    // Fatal assertion helper (require_*)
    export template<template <typename> class M, typename A, typename E>
    void require(M<std::common_type_t<A,E>> match, A&& actual, E&& expected, const std::source_location location = std::source_location::current(), const std::source_location matcher_location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        const auto ok = match(decayed(actual),decayed(expected));
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok,decayed(actual),decayed(expected),location,matcher_location);
        if(not ok)
        {
            throw assertion_failure{"Assertion failed"};
        }
    };

    // Equality and relational assertions (paired non-fatal/fatal helpers)
    export template<typename A, typename E>
    auto check_eq(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        return check(numeric_equal_to<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export template<typename A, typename E>
    void require_eq(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        require(numeric_equal_to<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    // Unlike the matchers above, these cast the operands. T is deducible from the epsilon
    // argument, so check_near(1.0f, 2.0f, 0.1) makes T double while common_type_t<A,E> is
    // float; the cast is what keeps the operands and the comparator on one type.
    export template<typename A, typename E, typename T = std::common_type_t<A,E>>
    requires std::is_floating_point_v<T>
    auto check_near(A&& actual, E&& expected, T epsilon = floating_point_equal<T>::default_epsilon, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        auto comparator = floating_point_equal<T>{epsilon};
        return check(comparator, static_cast<T>(actual), static_cast<T>(expected), location, matcher_location);
    };

    export template<typename A, typename E, typename T = std::common_type_t<A,E>>
    requires std::is_floating_point_v<T>
    void require_near(A&& actual, E&& expected, T epsilon = floating_point_equal<T>::default_epsilon, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        auto comparator = floating_point_equal<T>{epsilon};
        require(comparator, static_cast<T>(actual), static_cast<T>(expected), location, matcher_location);
    };

    export template<typename A, typename E>
    auto check_neq(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        return check(numeric_not_equal_to<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export template<typename A, typename E>
    void require_neq(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        require(numeric_not_equal_to<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export template<typename A, typename E>
    auto check_lt(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        return check(numeric_less<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export template<typename A, typename E>
    void require_lt(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        require(numeric_less<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export template<typename A, typename E>
    auto check_lteq(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        return check(numeric_less_equal<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export template<typename A, typename E>
    void require_lteq(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        require(numeric_less_equal<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export template<typename A, typename E>
    auto check_gt(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        return check(numeric_greater<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export template<typename A, typename E>
    void require_gt(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        require(numeric_greater<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export template<typename A, typename E>
    auto check_gteq(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        return check(numeric_greater_equal<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export template<typename A, typename E>
    void require_gteq(A&& actual, E&& expected, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        require(numeric_greater_equal<std::common_type_t<A,E>>{},std::forward<A>(actual),std::forward<E>(expected),location,matcher_location);
    };

    export auto check_true(bool actual, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        return check(std::equal_to<bool>{},actual,true,location,matcher_location);
    };

    export void require_true(bool actual, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        require(std::equal_to<bool>{},actual,true,location,matcher_location);
    };

    export auto check_false(bool actual, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        return check(std::equal_to<bool>{},actual,false,location,matcher_location);
    };

    export void require_false(bool actual, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        require(std::equal_to<bool>{},actual,false,location,matcher_location);
    };

    namespace {

    constexpr auto msg_expected_no_exception = "expected no exception"sv;
    constexpr auto msg_expected_exception = "expected exception"sv;
    constexpr auto msg_expected_exception_type = "expected exception of specified type"sv;
    constexpr auto msg_wrong_exception_type = "wrong exception type"sv;

    } // namespace

    // Outside anonymous namespace: check_throws_as is instantiated in test TUs.
    inline auto throws_as_failure_message(std::string_view actual) -> std::string_view
    {
        return actual == "?"sv ? "expected exception of specified type"sv : "wrong exception type"sv;
    }

    // Non-fatal exception assertions (check_*)
    export auto check_nothrow(auto&& t, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        auto ok = true;
        auto actual = std::string{"none"};
        const auto expected = "none"sv;
        try
        {
            ++data::statistics().total_assertions;
            t();
        }
        catch(const std::exception& e)
        {
            ok = not ok;
            actual = output::demangle_type(typeid(e));
        }
        catch(...)
        {
            ok = not ok;
            actual = "?"sv;
        }
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok, actual, expected, location, matcher_location, ok ? ""sv : msg_expected_no_exception);
    }

    export auto check_throws(auto&& t, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        auto ok = true;
        auto actual = std::string{"?"};
        const auto expected = "any"sv;
        try
        {
            ++data::statistics().total_assertions;
            t();
            ok = not ok;
            actual = "none"sv;
        }
        catch(const std::exception& e)
        {
            actual = output::demangle_type(typeid(e));
        }
        catch(...)
        {
            actual = "?"sv;
        }
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok, actual, expected, location, matcher_location, ok ? ""sv : msg_expected_exception);
    }

    export template<typename E>
    auto check_throws_as(auto&& t, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        auto ok = true;
        auto actual = std::string{"?"};
        const auto expected = output::demangle_type(typeid(E));
        try
        {
            ++data::statistics().total_assertions;
            t();
            ok = not ok;
        }
        catch(const E&)
        {
            actual = output::demangle_type(typeid(E));
        }
        catch(const std::exception& e)
        {
            ok = not ok;
            actual = output::demangle_type(typeid(e));
        }
        catch(...)
        {
            ok = not ok;
        }
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok, actual, expected, location, matcher_location, ok ? ""sv : throws_as_failure_message(actual));
    }

    // Deprecated: the exception argument was only ever used to deduce E, forcing
    // callers to construct a throwaway object whose value was discarded.
    export template<typename E>
    [[deprecated("name the exception type instead: check_throws_as<E>(callable)")]]
    auto check_throws_as(auto&& t, E, const std::source_location location = std::source_location::current())
    {
        return check_throws_as<E>(std::forward<decltype(t)>(t), location);
    }

    // Fatal exception assertions (require_*)
    export void require_nothrow(auto&& t, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        auto actual = std::string{"none"};
        const auto expected = "none"sv;
        try
        {
            ++data::statistics().total_assertions;
            t();
            ++data::statistics().successful_assertions;
            publisher::assertion(true,actual,expected,location,matcher_location);
        }
        catch(const std::exception& e)
        {
            actual = output::demangle_type(typeid(e));
            publisher::assertion(false, actual, expected, location, matcher_location, msg_expected_no_exception);
            throw assertion_failure{"Assertion failed: expected no exception"};
        }
        catch(...)
        {
            actual = "?"sv;
            publisher::assertion(false, actual, expected, location, matcher_location, msg_expected_no_exception);
            throw assertion_failure{"Assertion failed: expected no exception"};
        }
    }

    export void require_throws(auto&& t, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        auto actual = std::string{"?"};
        const auto expected = "any"sv;
        try
        {
            ++data::statistics().total_assertions;
            t();
            actual = "none"sv;
            publisher::assertion(false, actual, expected, location, matcher_location, msg_expected_exception);
            throw assertion_failure{"Assertion failed: expected exception"};
        }
        catch(const assertion_failure&)
        {
            throw;
        }
        catch(const std::exception& e)
        {
            actual = output::demangle_type(typeid(e));
            ++data::statistics().successful_assertions;
            publisher::assertion(true,actual,expected,location,matcher_location);
        }
        catch(...)
        {
            actual = "?"sv;
            ++data::statistics().successful_assertions;
            publisher::assertion(true,actual,expected,location,matcher_location);
        }
    }

    export template<typename E>
    void require_throws_as(auto&& t, const std::source_location location = std::source_location::current())
    {
        const auto matcher_location = std::source_location::current();
        auto actual = std::string{"?"};
        const auto expected = output::demangle_type(typeid(E));
        try
        {
            ++data::statistics().total_assertions;
            t();
            actual = "none"sv;
            publisher::assertion(false, actual, expected, location, matcher_location, msg_expected_exception_type);
            throw assertion_failure{"Assertion failed: expected exception of type " + std::string{expected}};
        }
        catch(const assertion_failure&)
        {
            throw;
        }
        catch(const E&)
        {
            actual = output::demangle_type(typeid(E));
            ++data::statistics().successful_assertions;
            publisher::assertion(true,actual,expected,location,matcher_location);
        }
        catch(const std::exception& e)
        {
            actual = output::demangle_type(typeid(e));
            publisher::assertion(false, actual, expected, location, matcher_location, msg_wrong_exception_type);
            throw assertion_failure{"Assertion failed: expected exception of type " + std::string{expected} + " but got " + std::string{actual}};
        }
        catch(...)
        {
            actual = "?"sv;
            publisher::assertion(false, actual, expected, location, matcher_location, msg_wrong_exception_type);
            throw assertion_failure{"Assertion failed: expected exception of type " + std::string{expected}};
        }
    }

    // Deprecated: see check_throws_as above.
    export template<typename E>
    [[deprecated("name the exception type instead: require_throws_as<E>(callable)")]]
    void require_throws_as(auto&& t, E, const std::source_location location = std::source_location::current())
    {
        require_throws_as<E>(std::forward<decltype(t)>(t), location);
    }

    export auto message(const bool ok, auto&& msg, const std::source_location location = std::source_location::current())
    {
        publisher::message(ok,msg,location);
    }

    export auto succeed(auto&& msg, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        ++data::statistics().successful_assertions;
        message(true,msg,location);
    }

    export auto failed(auto&& msg, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        message(false,msg,location);
    }

    export auto warning(auto&& msg, const std::source_location location = std::source_location::current())
    {
        message(true,msg,location);
    }

    // ============================================================================
    // Container equality assertions
    // ============================================================================

    // Helper to check if a type is a container (has begin/end iterators)
    template<typename T>
    concept is_container = requires(T& t) {
        t.begin();
        t.end();
        typename T::iterator;
    };

    // Helper to format container for error messages
    template<is_container C>
    std::string format_container(const C& container)
    {
        auto result = std::string{"["};
        bool first = true;
        for (const auto& elem : container) {
            if (!first) result += ", ";
            first = false;
            // The shared operand formatter, not `<<`: an element that has no stream
            // inserter — a pair, say — did not compile, so a container of them could not
            // be compared at all, and one that has one reads here as it does everywhere.
            result += output::value_to_display_string(elem);
        }
        result += "]";
        return result;
    }

    // Helper to compare containers and find first mismatch
    template<is_container A, is_container E>
    std::pair<bool, std::optional<std::string>> compare_containers(const A& actual, const E& expected)
    {
        auto actual_it = actual.begin();
        auto expected_it = expected.begin();
        auto actual_end = actual.end();
        auto expected_end = expected.end();
        std::size_t index = 0;

        while (actual_it != actual_end && expected_it != expected_end) {
            if (!values_equal(*actual_it, *expected_it)) {
                auto msg = std::ostringstream{};
                msg << "mismatch at index " << index
                    << ": actual=" << output::value_to_display_string(*actual_it)
                    << ", expected=" << output::value_to_display_string(*expected_it);
                return {false, msg.str()};
            }
            ++actual_it;
            ++expected_it;
            ++index;
        }

        if (actual_it != actual_end) {
            auto msg = std::ostringstream{};
            msg << "actual has " << (std::distance(actual_it, actual_end)) << " extra element(s) starting at index " << index;
            return {false, msg.str()};
        }

        if (expected_it != expected_end) {
            auto msg = std::ostringstream{};
            msg << "expected has " << (std::distance(expected_it, expected_end)) << " extra element(s) starting at index " << index;
            return {false, msg.str()};
        }

        return {true, std::nullopt};
    }

    export template<is_container A, is_container E>
    auto check_container_eq(const A& actual, const E& expected, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        const auto [ok, diff_msg] = compare_containers(actual, expected);
        data::statistics().successful_assertions += ok;
        
        // Format containers for output
        auto actual_str = format_container(actual);
        auto expected_str = format_container(expected);
        auto expected_final = expected_str;
        if (diff_msg.has_value()) {
            expected_final = expected_str + " (" + diff_msg.value() + ")";
        }
        
        publisher::assertion(ok, actual_str, expected_final, location);
        return ok;
    }

    export template<is_container A, is_container E>
    void require_container_eq(const A& actual, const E& expected, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        const auto [ok, diff_msg] = compare_containers(actual, expected);
        data::statistics().successful_assertions += ok;
        
        auto actual_str = format_container(actual);
        auto expected_str = format_container(expected);
        auto expected_final = expected_str;
        if (diff_msg.has_value()) {
            expected_final = expected_str + " (" + diff_msg.value() + ")";
        }
        
        publisher::assertion(ok, actual_str, expected_final, location);
        if (!ok) {
            auto msg = std::string{"Container equality assertion failed"};
            if (diff_msg.has_value()) {
                msg += ": " + diff_msg.value();
            }
            throw assertion_failure{msg};
        }
    }

    // ============================================================================
    // String-focused assertions
    // ============================================================================

    // Helper to check if type is string-like (including string literal arrays)
    template<typename T>
    concept is_string_like = std::is_same_v<T, std::string> || 
                             std::is_same_v<T, std::string_view> ||
                             std::is_same_v<T, const char*> ||
                             std::is_same_v<T, char*> ||
                             (std::is_array_v<T> && std::is_same_v<std::remove_extent_t<T>, char>);

    template<is_string_like S>
    std::string to_std_string(const S& s)
    {
        if constexpr (std::is_same_v<S, std::string>) {
            return s;
        } else if constexpr (std::is_same_v<S, std::string_view>) {
            return std::string{s};
        } else if constexpr (std::is_array_v<S>) {
            return std::string{s};
        } else {
            return std::string{s != nullptr ? s : ""};
        }
    }

    // String contains - must not match containers (std::string is a container but we want it here)
    export template<typename S1, typename S2>
    requires is_string_like<S1> && is_string_like<S2>
    auto check_contains(const S1& haystack, const S2& needle, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        auto haystack_str = to_std_string(haystack);
        auto needle_str = to_std_string(needle);
        const auto ok = haystack_str.contains(needle_str);
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok, haystack_str, std::string{"contains: "} + needle_str, location);
        return ok;
    }

    export template<typename S1, typename S2>
    requires is_string_like<S1> && is_string_like<S2>
    void require_contains(const S1& haystack, const S2& needle, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        auto haystack_str = to_std_string(haystack);
        auto needle_str = to_std_string(needle);
        const auto ok = haystack_str.contains(needle_str);
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok, haystack_str, std::string{"contains: "} + needle_str, location);
        if (!ok) {
            throw assertion_failure{"String does not contain expected substring: " + needle_str};
        }
    }

    export template<typename S1, typename S2>
    requires is_string_like<S1> && is_string_like<S2>
    auto check_has_substr(const S1& haystack, const S2& needle, const std::source_location location = std::source_location::current())
    {
        return check_contains(haystack, needle, location);
    }

    export template<typename S1, typename S2>
    requires is_string_like<S1> && is_string_like<S2>
    void require_has_substr(const S1& haystack, const S2& needle, const std::source_location location = std::source_location::current())
    {
        require_contains(haystack, needle, location);
    }

    // Helper to check if string starts with prefix
    template<typename Str>
    bool string_starts_with(const Str& str, const std::string& prefix)
    {
        auto str_s = to_std_string(str);
        if constexpr (requires { str_s.starts_with(prefix); }) {
            return str_s.starts_with(prefix);
        } else {
            return str_s.size() >= prefix.size() && str_s.substr(0, prefix.size()) == prefix;
        }
    }

    template<typename Str>
    bool string_ends_with(const Str& str, const std::string& suffix)
    {
        auto str_s = to_std_string(str);
        if constexpr (requires { str_s.ends_with(suffix); }) {
            return str_s.ends_with(suffix);
        } else {
            return str_s.size() >= suffix.size() && str_s.substr(str_s.size() - suffix.size()) == suffix;
        }
    }

    export template<typename S1, typename S2>
    requires is_string_like<S1> && is_string_like<S2>
    auto check_starts_with(const S1& str, const S2& prefix, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        auto str_val = to_std_string(str);
        auto prefix_val = to_std_string(prefix);
        const auto ok = string_starts_with(str, prefix_val);
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok, str_val, std::string{"starts with: "} + prefix_val, location);
        return ok;
    }

    export template<typename S1, typename S2>
    requires is_string_like<S1> && is_string_like<S2>
    void require_starts_with(const S1& str, const S2& prefix, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        auto str_val = to_std_string(str);
        auto prefix_val = to_std_string(prefix);
        const auto ok = string_starts_with(str, prefix_val);
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok, str_val, std::string{"starts with: "} + prefix_val, location);
        if (!ok) {
            throw assertion_failure{"String does not start with expected prefix: " + prefix_val};
        }
    }

    export template<typename S1, typename S2>
    requires is_string_like<S1> && is_string_like<S2>
    auto check_ends_with(const S1& str, const S2& suffix, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        auto str_val = to_std_string(str);
        auto suffix_val = to_std_string(suffix);
        const auto ok = string_ends_with(str, suffix_val);
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok, str_val, std::string{"ends with: "} + suffix_val, location);
        return ok;
    }

    export template<typename S1, typename S2>
    requires is_string_like<S1> && is_string_like<S2>
    void require_ends_with(const S1& str, const S2& suffix, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        auto str_val = to_std_string(str);
        auto suffix_val = to_std_string(suffix);
        const auto ok = str_val.ends_with(suffix_val);
        data::statistics().successful_assertions += ok;
        publisher::assertion(ok, str_val, std::string{"ends with: "} + suffix_val, location);
        if (!ok) {
            throw assertion_failure{"String does not end with expected suffix: " + suffix_val};
        }
    }

    // For char overloads (check if string contains a character) - these must come before container template to avoid ambiguity
    export auto check_contains(const std::string& haystack, char needle, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        const auto ok = haystack.contains(needle);
        data::statistics().successful_assertions += ok;
        auto needle_str = std::string(1, needle);
        publisher::assertion(ok, haystack, std::string{"contains: '"} + needle_str + "'", location);
        return ok;
    }

    export void require_contains(const std::string& haystack, char needle, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        const auto ok = haystack.contains(needle);
        data::statistics().successful_assertions += ok;
        auto needle_str = std::string(1, needle);
        publisher::assertion(ok, haystack, std::string{"contains: '"} + needle_str + "'", location);
        if (!ok) {
            throw assertion_failure{"String does not contain expected character: '" + needle_str + "'"};
        }
    }

    // ============================================================================
    // Container "contains element" matchers
    // ============================================================================
    // Note: These must come after string contains to avoid ambiguity
    // They require the first parameter to be a container but NOT a string-like type

    export template<typename C, typename E>
    requires is_container<C> && (!is_string_like<C>)
    auto check_contains(const C& container, const E& element, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        const auto ok = std::ranges::any_of(container,
            [&element](const auto& candidate){ return values_equal(candidate, element); });
        data::statistics().successful_assertions += ok;
        
        auto container_str = format_container(container);
        publisher::assertion(ok, container_str,
                             std::string{"contains: "} + output::value_to_display_string(element), location);
        return ok;
    }

    export template<typename C, typename E>
    requires is_container<C> && (!is_string_like<C>)
    void require_contains(const C& container, const E& element, const std::source_location location = std::source_location::current())
    {
        ++data::statistics().total_assertions;
        const auto ok = std::ranges::any_of(container,
            [&element](const auto& candidate){ return values_equal(candidate, element); });
        data::statistics().successful_assertions += ok;
        
        auto container_str = format_container(container);
        publisher::assertion(ok, container_str,
                             std::string{"contains: "} + output::value_to_display_string(element), location);
        if (!ok) {
            auto msg = std::ostringstream{};
            msg << "Container does not contain expected element: "
                << output::value_to_display_string(element);
            throw assertion_failure{msg.str()};
        }
    }

}
