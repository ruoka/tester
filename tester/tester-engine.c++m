export module tester:engine;
import :observer;
import :data;
import :utils;
import :assertions;
import std;

namespace tester::engine {

using namespace data;
using namespace std::literals;
using output::notify;
using output::observer;

void execute_test_case(execution_context& ctx, test_case& tc);

// The API is `construct("name") = body`, so an assignment is the only place a case can be handed
// its body — and the only place the two kinds of case part company. A scenario or test_case is
// stored for the run loop; a step runs right here, in the frame it was written in, which is what
// lets it capture the enclosing locals by reference. Deferring the step instead left every such
// capture dangling by the time it ran.
class test_slot
{
public:
    explicit test_slot(test_case& registered) noexcept
        : m_state{registered_case{registered}}
    {}

    // A step is only ever made while a run is under way, and is assigned in the same statement,
    // so the context it reports to is the one that was active when it was made.
    test_slot(test_case&& step, execution_context& context) noexcept
        : m_state{nested_case{std::move(step), context}}
    {}

    template<typename Body>
    void operator=(Body&& body)
    {
        std::visit([&](auto& state){ state.assign(std::forward<Body>(body)); }, m_state);
    }

private:
    // Already in the list the run iterates, so the body has to land in that element: holding a
    // copy here would take the body and leave the runner with the empty case.
    struct registered_case
    {
        std::reference_wrapper<test_case> target;

        template<typename Body>
        void assign(Body&& body) const
        {
            target.get().run = std::forward<Body>(body);
        }
    };

    // Never registered, so the slot owns the case — for the length of the statement that runs it.
    struct nested_case
    {
        test_case step;
        std::reference_wrapper<execution_context> context;

        template<typename Body>
        void assign(Body&& body)
        {
            step.run = std::forward<Body>(body);
            execute_test_case(context, step);
        }
    };

    std::variant<registered_case, nested_case> m_state;
};

test_slot make_test_case(std::string_view description, int priority, std::vector<std::string> depends_on, std::string id, const std::source_location location1, const std::source_location location2) noexcept
{
    auto test_type = std::string_view{location2.function_name()};

    auto drop_prefix = [&](std::string_view marker)
    {
        if(auto pos = test_type.find(marker); pos != std::string_view::npos)
        {
            test_type.remove_prefix(pos + marker.size());
            return true;
        }
        return false;
    };

    // Strip the qualification of the registering wrapper, leaving the bare name
    // (test_case, section, scenario, given, when, then) for the display name.
    // Registration only ever comes from tester::basic or
    // tester::behavior_driven_development; a wrapper added elsewhere degrades to its
    // own unqualified name rather than aborting the process.
    if(not drop_prefix("behavior_driven_development::") and not drop_prefix("basic::"))
    {
        const auto paren = test_type.find('(');
        if(const auto pos = test_type.rfind("::", paren); pos != std::string_view::npos)
            test_type.remove_prefix(pos + 2);
    }

    if(const auto paren = test_type.find('('); paren != std::string_view::npos)
        test_type.remove_suffix(test_type.length() - paren);

    auto test_name = std::string{test_type} + " -> "s + std::string{description};
    auto assigned_id = id.empty() ? test_name : std::move(id);
    auto test_case = data::test_case{
        {location1.function_name(),test_name,location1.file_name(),location1.line(),location1.column(),location2.function_name(), assigned_id},
        data::test{},
        priority,
        std::move(depends_on),
        std::move(assigned_id),
        output::extract_bracket_tags(description)
    };

    // scenario and test_case are what a run iterates; the rest are steps of whichever case is
    // running. A step written where no case is running has no frame to belong to, so it becomes
    // an ordinary case rather than executing before the run it would report to has begun.
    auto* const execution = active_execution();
    if(test_type.contains("scenario") or test_type.contains("test_case") or execution == nullptr)
    {
        // Parallel workers may append nested scenarios mid-run; the scheduler drains
        // the catalogue between waves, so the push has to be atomic with reading .back().
        auto lock = std::lock_guard<std::mutex>{test_cases_mutex};
        test_cases.push_back(std::move(test_case));
        return test_slot{test_cases.back()};
    }

    return test_slot{std::move(test_case), *execution};
}

// An id defaults to the display name, so prefer it: an explicit one is what depends_on names.
std::string_view label(const test_case& tc)
{
    return tc.id.empty() ? tc.test_name : tc.id;
}

auto sort_test_cases()
{
    // An id is how depends_on names a case, so two cases claiming one id make the edge
    // ambiguous. The map used to keep whichever registered last and the run still looked
    // ordered, which is the failure mode worth refusing: the suite ran, but not as written.
    auto id_to_test = std::map<std::string, test_case*, std::less<>>{};
    for(auto& tc : test_cases)
    {
        if(tc.id.empty())
            continue;
        if(id_to_test.contains(tc.id))
            throw std::runtime_error{"Duplicate test id \"" + tc.id + "\" used by \""
                + id_to_test.at(tc.id)->test_name + "\" and \"" + tc.test_name + "\""};
        id_to_test[tc.id] = &tc;
    }

    // Calculate dependency levels (tests with no dependencies = level 0, etc.)
    auto levels = std::map<test_case*, int>{};
    auto visiting = std::flat_set<test_case*>{};
    auto calculate_level = [&](test_case* tc, auto& self)
    {
        if(levels.contains(tc))
            return levels.at(tc);

        // A re-visit while still resolving ancestors means depends_on formed a cycle.
        // Fail clearly instead of recursing until the stack overflows.
        if(visiting.contains(tc))
            throw std::runtime_error{"Cyclic test dependency involving \"" + std::string{label(*tc)} + "\""};

        visiting.insert(tc);
        int max_dep_level = -1;
        for(const auto& dep_id : tc->depends_on)
        {
            // A name nothing registered used to contribute no edge and no diagnostic, so a
            // typo read as "no ordering constraint" and the run passed on the wrong order.
            if(not id_to_test.contains(dep_id))
                throw std::runtime_error{"Unknown test id \"" + dep_id + "\" in depends_on of \""
                    + std::string{label(*tc)} + "\""};
            max_dep_level = std::max(max_dep_level, self(id_to_test.at(dep_id), self));
        }
        visiting.erase(tc);
        levels[tc] = max_dep_level + 1;
        return levels.at(tc);
    };

    for(auto& tc : test_cases)
        calculate_level(&tc, calculate_level);

    // Sort: first by dependency level, then by priority
    auto sorted = std::vector<test_case*>{};
    for(auto& tc : test_cases)
        sorted.push_back(&tc);

    auto compare = [&levels](const test_case* a, const test_case* b)
    {
        const auto level_a = levels[const_cast<test_case*>(a)];
        const auto level_b = levels[const_cast<test_case*>(b)];
        if(level_a != level_b)
            return level_a < level_b;  // Lower level (dependencies) first
        return a->priority < b->priority;  // Within same level, lower priority first
    };
    std::stable_sort(sorted.begin(), sorted.end(), compare);

    // Copy test cases before clearing the list (to avoid invalidating pointers)
    auto test_cases_copy = std::vector<test_case>{};
    test_cases_copy.reserve(sorted.size());
    for(auto* tc : sorted)
        test_cases_copy.push_back(*tc);

    // Rebuild test_cases list in sorted order
    test_cases.clear();
    for(auto& tc : test_cases_copy)
        test_cases.push_back(tc);
}

export void init_statistics(
    execution_context& ctx,
    std::chrono::steady_clock::time_point run_started,
    std::chrono::system_clock::time_point run_started_unix_ms,
    std::string_view run_tags)
{
    auto& stats = ctx.statistics;
    stats.run_started = run_started;
    stats.run_started_unix_ms = run_started_unix_ms;
    stats.run_tags = std::string{run_tags};
    stats.successful_tests = 0;
    stats.total_tests = 0;
    stats.successful_assertions = 0;
    stats.total_assertions = 0;
    ctx.results.clear();
    ctx.step_assertions_total = 0;
    ctx.step_assertions_ok = 0;
    ctx.current_output = nullptr;
    ctx.clear_test_id();
}

export void finish_statistics(
    execution_context& ctx,
    std::chrono::steady_clock::time_point run_finished)
{
    ctx.statistics.run_finished = run_finished;
}

// One case, whether the run loop reached it or an enclosing case started it as a step. Steps used
// to come back here through the loop, which is why this had to be one place rather than two: a
// step is reported, counted and filtered exactly like the case it belongs to.
void execute_test_case(execution_context& ctx, test_case& tc)
{
    if(ctx.excluded and ctx.excluded(tc))
        return;

    // Reserved before the body runs, so a case is listed ahead of the steps it starts. The
    // deferred design got that order by inserting each step in front of its parent; running the
    // step where it is written gets it from the call stack, and test_metadata is const, so the
    // fields the run fills are written in place rather than assigned.
    auto& result = *ctx.results.insert(ctx.results.end(), test_result{tc});

    // One capture buffer serves every case, so the enclosing case's text comes off it before this
    // case resets it, and the buffer is handed back empty when this case is done.
    auto* const outer_output = ctx.current_output;
    auto output = std::string{};
    if(outer_output)
        *outer_output += output::captured_text();
    ctx.current_output = &output;

    const auto outer_id = ctx.current_test_id;

    notify([&](observer& target){ target.test_case(tc); });

    ctx.set_test_id(tc.test_id);

    auto& stats = ctx.statistics;
    const auto assertions_total_before = stats.total_assertions;
    const auto assertions_ok_before = stats.successful_assertions;
    const auto steps_total_before = ctx.step_assertions_total;
    const auto steps_ok_before = ctx.step_assertions_ok;

    const auto started = std::chrono::steady_clock::now();
    const auto started_sys = std::chrono::system_clock::now();
    auto failure_message = std::string{};
    try
    {
        ++stats.total_tests;
        tc.run();
    }
    catch(const assertions::assertion_failure& ex)
    {
        result.success = false;
        failure_message = ex.what();
        notify([&](observer& target){ target.exception(tc, ex); });
    }
    catch(const std::exception& ex)
    {
        result.success = false;
        failure_message = ex.what();
        notify([&](observer& target){ target.exception(tc, ex); });
    }
    catch(...)
    {
        result.success = false;
        failure_message = "Unknown exception";
        notify([&](observer& target){ target.exception(tc, std::runtime_error{"Unknown exception"}); });
    }
    const auto finished = std::chrono::steady_clock::now();
    const auto finished_sys = std::chrono::system_clock::now();

    const auto assertions_total = stats.total_assertions - assertions_total_before;
    const auto assertions_ok = stats.successful_assertions - assertions_ok_before;
    // A step's assertions are the step's own. Taking off what the steps consumed leaves what this
    // case checked itself, so a scenario still reports its own count and a failing step fails
    // itself rather than everything it is written inside.
    //
    // Each step adds only its own, never its descendants': every step in the subtree adds its own
    // while this body runs, and those sum to exactly what the immediate steps consumed. Adding
    // the whole subtree instead counted the deeper steps once per level between them.
    result.assertions_total = assertions_total - (ctx.step_assertions_total - steps_total_before);
    result.assertions_ok = assertions_ok - (ctx.step_assertions_ok - steps_ok_before);
    if(outer_output)
    {
        ctx.step_assertions_total += result.assertions_total;
        ctx.step_assertions_ok += result.assertions_ok;
    }

    result.duration = std::chrono::duration_cast<std::chrono::nanoseconds>(finished - started);
    result.started_at = started_sys;
    result.finished_at = finished_sys;

    // A non-fatal check_* failure does not throw, so returning normally is not enough to call
    // the test successful. Counting it here — rather than right after run() — keeps
    // summary.tests_ok consistent with failed_test_ids.
    if(result.success and result.assertions_ok == result.assertions_total)
        ++stats.successful_tests;
    else
        result.success = false;

    // Back to the case this one is a step of, so its remaining assertions are attributed to it.
    if(outer_id.empty())
        ctx.clear_test_id();
    else
        ctx.set_test_id(outer_id);

    // The captured output holds the per-assertion detail, which is precisely what
    // a reader needs for a failure. Using the exception message instead meant a
    // check_*-only failure — which throws nothing — reported no detail at all.
    output += output::captured_text();
    output::reset_captured_text();
    ctx.current_output = outer_output;
    if(not failure_message.empty())
        output += failure_message + '\n';
    result.output = std::move(output);
}

void merge_worker(execution_context& dest, execution_context& worker)
{
    dest.statistics.successful_tests += worker.statistics.successful_tests;
    dest.statistics.total_tests += worker.statistics.total_tests;
    dest.statistics.successful_assertions += worker.statistics.successful_assertions;
    dest.statistics.total_assertions += worker.statistics.total_assertions;
    dest.results.splice(dest.results.end(), worker.results);
}

// Soft asserts from a test-spawned thread have no worker TLS, so under --jobs>1 they
// update the run-wide fallback context instead of the worker that owns the case. The
// worker's test_result stays green while the orphaned counters make run_passed false —
// empty failed_test_ids. Reify the gap as an explicit failing result for triage.
void reconcile_unattributed_assertions(execution_context& ctx)
{
    auto accounted_total = std::size_t{0};
    auto accounted_ok = std::size_t{0};
    for(const auto& result : ctx.results)
    {
        accounted_total += result.assertions_total;
        accounted_ok += result.assertions_ok;
    }

    const auto& stats = ctx.statistics;
    if(stats.total_assertions == accounted_total
       and stats.successful_assertions == accounted_ok)
        return;

    if(stats.total_assertions < accounted_total
       or stats.successful_assertions < accounted_ok)
        return;

    const auto missing_total = stats.total_assertions - accounted_total;
    const auto missing_ok = stats.successful_assertions - accounted_ok;
    if(missing_total == 0)
        return;

    auto result = test_result{
        test_metadata{
            .test_set_name = "tester",
            .test_name = "unattributed thread assertion",
            .file_name = {},
            .line = 0,
            .column = 0,
            .function_name = {},
            .test_id = "<unattributed thread assertion>",
        }};
    result.assertions_total = missing_total;
    result.assertions_ok = missing_ok;
    result.success = missing_ok == missing_total;
    if(not result.success)
    {
        result.output =
            "A soft assertion ran on a thread without an execution_context while "
            "--jobs>1, so it could not be attributed to the test that started the thread.\n";
    }
    ctx.results.push_back(std::move(result));
    ++ctx.statistics.total_tests;
    if(missing_ok == missing_total)
        ++ctx.statistics.successful_tests;
}

void run_test_cases_sequential(execution_context& ctx)
{
    // Erasing the case that just ran is what lets the loop pick up cases registered while it
    // runs: steps never arrive here — they go straight through execute_test_case — but a
    // scenario or test_case written inside another one is appended and reached by a later turn.
    while(not test_cases.empty())
    {
        auto tc = test_cases.begin();
        execute_test_case(ctx, *tc);
        test_cases.erase(tc);
    }
}

void run_test_cases_parallel(execution_context& ctx, std::size_t jobs)
{
    // Wave scheduler: a case is ready when every depends_on id has completed. Ready cases run
    // concurrently (bounded by jobs); the next wave starts only after the current one joins, so
    // ordering edges stay intact. Mid-run registrations land in test_cases and become eligible
    // on the following wave — the same “append then reach later” contract as the sequential path,
    // without re-running sort_test_cases (which would reject depends_on ids already erased).
    auto completed = std::flat_set<std::string, std::less<>>{};

    while(not test_cases.empty())
    {
        auto ready = std::vector<std::list<test_case>::iterator>{};
        {
            auto lock = std::lock_guard<std::mutex>{test_cases_mutex};
            for(auto it = test_cases.begin(); it != test_cases.end(); ++it)
            {
                if(std::ranges::all_of(it->depends_on, [&](const std::string& dep) {
                       return completed.contains(dep);
                   }))
                {
                    ready.push_back(it);
                }
            }
        }

        if(ready.empty())
        {
            throw std::runtime_error{
                "No runnable tests remain but the catalogue is not empty (broken depends_on?)"};
        }

        // A single ready case stays on this thread — no merge, and nested registrations are
        // visible to the next iteration immediately after it returns.
        if(ready.size() == 1)
        {
            auto it = ready.front();
            execute_test_case(ctx, *it);
            if(not it->id.empty())
                completed.insert(it->id);
            auto lock = std::lock_guard<std::mutex>{test_cases_mutex};
            test_cases.erase(it);
            continue;
        }

        auto batch = std::vector<test_case>{};
        batch.reserve(ready.size());
        {
            auto lock = std::lock_guard<std::mutex>{test_cases_mutex};
            for(auto it : ready)
            {
                batch.push_back(std::move(*it));
                test_cases.erase(it);
            }
        }

        // Spawn at most `jobs` OS threads at a time. A semaphore acquired inside each
        // thread would still create one stack per ready case — large independent waves
        // then die with std::system_error before any summary is written.
        for(std::size_t offset = 0; offset < batch.size(); offset += jobs)
        {
            const auto chunk = std::min(jobs, batch.size() - offset);
            auto workers = std::vector<execution_context>(chunk);
            auto threads = std::vector<std::jthread>{};
            threads.reserve(chunk);

            for(std::size_t i = 0; i < chunk; ++i)
            {
                threads.emplace_back([&, i, offset]
                {
                    workers[i].excluded = ctx.excluded;
                    const auto scope = execution_scope{workers[i]};
                    execute_test_case(workers[i], batch[offset + i]);
                });
            }
            threads.clear(); // join before merge

            // Merge in batch order (registration / catalogue order), not completion order.
            for(auto& worker : workers)
                merge_worker(ctx, worker);
        }

        for(const auto& tc : batch)
        {
            if(not tc.id.empty())
                completed.insert(tc.id);
        }
    }

    reconcile_unattributed_assertions(ctx);
}

export void run_test_cases(execution_context& ctx)
{
    sort_test_cases();

    const auto jobs = worker_count();
    if(jobs == 1)
        run_test_cases_sequential(ctx);
    else
        run_test_cases_parallel(ctx, jobs);
}

}
